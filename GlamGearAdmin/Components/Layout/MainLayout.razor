@using GlamGearAdmin.Models.AppModels
@inherits LayoutComponentBase

@implements IDisposable
@inject NavigationManager NavigationManager
@inject InternetCheckerService InternetChecker
@* @inject ThemeToggler toggle *@

@if (isOnline == null)
{
    <div class="position-absolute top-50 start-50 translate-middle">
        <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (isOnline == true)
{
    <div class="page">
        @* <div class=@(toggle!.CollapseNavMenu ? "sidebar d-none" : "sidebar d-block")> *@
        <NavMenu2 />
        @* </div> *@

        <main>
            <div class="border-bottom border-1 border-secondary-subtle top-row px-4">
                <MudBlazor.MudIconButton type="submit" Icon="@MudBlazor.Icons.Material.Filled.Logout" title="Logout"
                    class="nav-link" data-bs-toggle="modal" data-bs-target="#logoutModal" />
                <BlazorBootstrap.ThemeSwitcher @rendermode="RenderMode.InteractiveServer" Class="ms-0 p-0" />
                <span><a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a></span>
            </div>

            <article class="content page-footer px-4 small">
                @Body
            </article>
            <footer class="m-0 py-3 w-100 text-bg-dark">
                <p class="text-white text-center m-0 small">&copy; @(DateTime.Today.Year) Raquel Pawnshop, Inc. All rights
                    reserved.</p>
            </footer>
        </main>
    </div>

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>

    <div class="modal fade" id="logoutModal" data-bs-keyboard="false" tabindex="-1" aria-labelledby="logoutModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-body">
                    Are you sure you want to logout?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="btn btn-danger">Confirm</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="position-absolute top-50 start-50 translate-middle">
        <div class="fw-bold display-6 mb-3">
            No internet connectivity.
        </div>
        <div class="d-flex justify-content-start">
            <button type="submit" class="btn btn-primary" onclick="location.reload()">
                Reload
            </button>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    protected SidebarToggler? toggle { get; set; }
    @* private ThemeToggler toggle = new() { CollapseNavMenu = false }; *@
    private string? currentUrl;
    private bool? isOnline;

    protected override async Task OnInitializedAsync()
    {
        isOnline = await InternetChecker.IsOnlineAsync();
    }
    protected override void OnInitialized()
    {
        @* toggle.OnChange += StateHasChanged; *@
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        @* toggle.OnChange -= StateHasChanged; *@
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}