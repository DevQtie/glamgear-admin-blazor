@page "/products/product-list"
@using GlamGearAdmin.Data.SQLServer
@using GlamGearAdmin.Models.SQLServer
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject NavigationManager NavigationManager
@inject IDbContextFactory<GlamGearAdmin.Data.SQLServer.BlazorSQLServerContext> DbFactory

<PageTitle>Product List</PageTitle>

<h3>Product List</h3>

@if (prodList is null)
{
  <div class="position-absolute top-50 start-50 translate-middle">
    <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
      <span class="visually-hidden">Loading...</span>
    </div>
  </div>
}
else
{
  <button class="btn btn-primary my-3" @onclick="ButtonClicked">Image Simulation</button>
  <div class="input-group mb-3 w-50">
    <input type="search" class="form-control border-outline-secondary" placeholder="Filter by display name"
      @bind="imgNameFilter" @bind:event="oninput" />
  </div>

  <div class="d-flex justify-content-between align-items-center flex-wrap my-4">
    <div>
      <nav>
        <ul class="pagination pagination-md m-0">
          <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
            <button class="page-link" @onclick="PreviousPage">Previous</button>
          </li>
          <li class="page-item">
            <span class="page-link text-secondary bg-transparent">Page
              @pagination.CurrentPage of @TotalPages</span>
          </li>
          <li class="page-item">
            <span class="page-link text-secondary bg-transparent">Showing @pagedProdList.Count() of
              @filteredProdList.Count() records</span>
          </li>
          <li class="page-item @(pagination.CurrentPage >= TotalPages ? "disabled" : "")">
            <button class="page-link" @onclick="NextPage">Next</button>
          </li>
        </ul>
      </nav>
    </div>
    <div role="group">
      <button class="@(initPerPage == PaginationPerPage.Five ? "btn btn-primary" : "btn btn-outline-secondary")"
        @onclick="FivePerPageBtn">@($"{(int)PaginationPerPage.Five}")</button>
      <button class="@(initPerPage == PaginationPerPage.Ten ? "btn btn-primary" : "btn btn-outline-secondary")"
        @onclick="TenPerPageBtn">@($"{(int)PaginationPerPage.Ten}")</button>
      <button class="@(initPerPage == PaginationPerPage.Fifteen ? "btn btn-primary" : "btn btn-outline-secondary")"
        @onclick="FifteenPerPageBtn">@($"{(int)PaginationPerPage.Fifteen}")</button>
      <button class="@(initPerPage == PaginationPerPage.Thirty ? "btn btn-primary" : "btn btn-outline-secondary")"
        @onclick="ThirthPerPageBtn">@($"{(int)PaginationPerPage.Thirty}")</button>
      <button class="@(initPerPage == PaginationPerPage.Fifty ? "btn btn-primary" : "btn btn-outline-secondary")"
        @onclick="FiftyPerPageBtn">@($"{(int)PaginationPerPage.Fifty}")</button>
      <button class="@(initPerPage == PaginationPerPage.ShowAll ? "btn btn-primary" : "btn btn-outline-secondary")"
        @onclick="ShowAllPerPageBtn">Show All</button>
      <span class="fw-normal">Per Page</span>
    </div>
  </div>

  <div class="table-responsive card m-0">
    <table class="table table-bordered table-hover overflow-auto m-0">
      <thead class="align-middle">
        <tr>
          <th @onclick='() => SortBy("#")' class="cursor-pointer"># @SortIcon("#")</th>
          <th>Role</th>
          <th @onclick='() => SortBy("ImgName")' class="cursor-pointer">Image Name @SortIcon("ImgName")
          </th>
          <th @onclick='() => SortBy("Size")' class="cursor-pointer">Size @SortIcon("Size")
          </th>
          <th @onclick='() => SortBy("DtStamp")' class="cursor-pointer">Date Stamp @SortIcon("DtStamp")</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var a in SortedProdList)
        {
          <tr>
            <td class="align-middle">@a.Hash</td>
            <td class="align-middle"><img src="@dbDataToImg(a.ProdData)"
                class="img-thumbnail rounded rounded-3 cus-img-thumbnail-sm p-0 my-1" alt="Product" /></td>
            <td class="align-middle">@a.ImgName</td>
            <td class="align-middle">@a.Size</td>
            <td class="align-middle">@a.DtStamp</td>
            <td class="align-middle text-nowrap">
              <div class="d-flex flex-column h-100 justify-content-center gap-2">
                <!--Remove text-nowrap if there are more link button to show-->

                <Tooltip Class="d-flex justify-content-center" Title="Review" Placement="TooltipPlacement.Top"><a
                    class="btn btn-outline-primary btn-sm" href="@($"users/review-user?userid={a.ProdID}")">
                    <Icon Name="IconName.PencilSquare" />
                  </a></Tooltip>
                @* <Tooltip Class="d-flex justify-content-center" Title="Tooltip Left" Placement="TooltipPlacement.Top"><a
                      class="btn btn-outline-primary btn-sm"
                      href="@($"sql_server/crud/admin_pages/details?userid={a.UserID}")">
                      <Icon Name="IconName.InfoCircleFill" />
                    </a></Tooltip> *@ <!--reserved-->
              </div>
            </td>
          </tr>
        }
      </tbody>
      <thead class="align-middle">
        <tr>
          <th @onclick='() => SortBy("#")' class="cursor-pointer"># @SortIcon("#")</th>
          <th>Role</th>
          <th @onclick='() => SortBy("ImgName")' class="cursor-pointer">Image Name @SortIcon("ImgName")
          </th>
          <th @onclick='() => SortBy("Size")' class="cursor-pointer">Size @SortIcon("Size")
          </th>
          <th @onclick='() => SortBy("DtStamp")' class="cursor-pointer">Date Stamp @SortIcon("DtStamp")</th>
          <th>Actions</th>
        </tr>
      </thead>
    </table>
  </div>

  <div class="d-flex justify-content-between align-items-center flex-wrap my-4">
    <div>
      <nav>
        <ul class="pagination pagination-md m-0">
          <li class="page-item @(pagination.CurrentPage == 1 ? "disabled" : "")">
            <button class="page-link" @onclick="PreviousPage">Previous</button>
          </li>
          <li class="page-item disabled">
            <span class="page-link">Page @pagination.CurrentPage of @TotalPages</span>
          </li>
          <li class="page-item disabled">
            <span class="page-link">Showing @pagedProdList.Count() of @filteredProdList.Count() records</span>
          </li>
          <li class="page-item @(pagination.CurrentPage >= TotalPages ? "disabled" : "")">
            <button class="page-link" @onclick="NextPage">Next</button>
          </li>
        </ul>
      </nav>
    </div>
    <div role="group">
      <button class="@(initPerPage == PaginationPerPage.Five ? "btn btn-primary" : "btn btn-outline-secondary")"
        @onclick="FivePerPageBtn">@($"{(int)PaginationPerPage.Five}")</button>
      <button class="@(initPerPage == PaginationPerPage.Ten ? "btn btn-primary" : "btn btn-outline-secondary")"
        @onclick="TenPerPageBtn">@($"{(int)PaginationPerPage.Ten}")</button>
      <button class="@(initPerPage == PaginationPerPage.Fifteen ? "btn btn-primary" : "btn btn-outline-secondary")"
        @onclick="FifteenPerPageBtn">@($"{(int)PaginationPerPage.Fifteen}")</button>
      <button class="@(initPerPage == PaginationPerPage.Thirty ? "btn btn-primary" : "btn btn-outline-secondary")"
        @onclick="ThirthPerPageBtn">@($"{(int)PaginationPerPage.Thirty}")</button>
      <button class="@(initPerPage == PaginationPerPage.Fifty ? "btn btn-primary" : "btn btn-outline-secondary")"
        @onclick="FiftyPerPageBtn">@($"{(int)PaginationPerPage.Fifty}")</button>
      <button class="@(initPerPage == PaginationPerPage.ShowAll ? "btn btn-primary" : "btn btn-outline-secondary")"
        @onclick="ShowAllPerPageBtn">Show All</button>
      <span class="fw-normal">Per Page</span>
    </div>
  </div>
}

@code {
  private void ButtonClicked() => NavigationManager.NavigateTo("simulate/images");
  private enum PaginationPerPage
  {
    Five = 5,
    Ten = 10,
    Fifteen = 15,
    Thirty = 30,
    Fifty = 50,
    ShowAll = 0,

  }
  private static PaginationPerPage initPerPage = PaginationPerPage.Five;
  private BlazorSQLServerContext context = default!;
  private List<ProductList> prodList = new();
  private PaginationState pagination = new PaginationState();
  private string imgNameFilter = string.Empty;

  private IEnumerable<ProductList> filteredProdList => string.IsNullOrWhiteSpace(imgNameFilter)
  ? prodList : (initPerPage ==
  PaginationPerPage.ShowAll)
  ? prodList.Where(data => data.ImgName?.ToLower().Contains(imgNameFilter.ToLower()) == true) : prodList.Where(data
  =>
  data.ImgName?.ToLower().Contains(imgNameFilter.ToLower()) == true);

  private IEnumerable<ProductList> pagedProdList => filteredProdList
  .Skip((pagination.CurrentPage - 1) * pagination.ItemsPerPage)
  .Take(pagination.ItemsPerPage);

  private int TotalPages => (int)Math.Ceiling((double)filteredProdList.Count() / pagination.ItemsPerPage);
  private string currentSortColumn = ""; // to let the SP's select ordered by script handle sorting
  private bool sortAscending = true;
  private IEnumerable<ProductList> SortedProdList => currentSortColumn switch
  {
    "#" => sortAscending ? pagedProdList.OrderBy(a => a.Hash) : pagedProdList.OrderByDescending(a =>
    a.Hash),
    "ImgName" => sortAscending ? pagedProdList.OrderBy(a => a.ImgName) : pagedProdList.OrderByDescending(a =>
    a.ImgName),
    "Size" => sortAscending ? pagedProdList.OrderBy(a => a.Size) : pagedProdList.OrderByDescending(a => a.Size),
    "DtStamp" => sortAscending ? pagedProdList.OrderBy(a => a.DtStamp) : pagedProdList.OrderByDescending(a => a.DtStamp),
    _ => pagedProdList
  };
  private void SortBy(string column)
  {
    if (currentSortColumn == column)
    {
      sortAscending = !sortAscending;
    }
    else
    {
      currentSortColumn = column;
      sortAscending = true;
    }
  }

  private void FivePerPageBtn()
  {
    initPerPage = PaginationPerPage.Five;
  }

  private void TenPerPageBtn()
  {
    initPerPage = PaginationPerPage.Ten;
    if (pagination.CurrentPage > TotalPages)
    {
      pagination.CurrentPage = TotalPages;
    }
  }

  private void FifteenPerPageBtn()
  {
    initPerPage = PaginationPerPage.Fifteen;
    if (pagination.CurrentPage > TotalPages)
    {
      pagination.CurrentPage = TotalPages;
    }
  }

  private void ThirthPerPageBtn()
  {
    initPerPage = PaginationPerPage.Thirty;
    if (pagination.CurrentPage > TotalPages)
    {
      pagination.CurrentPage = TotalPages;
    }
  }

  private void FiftyPerPageBtn()
  {
    initPerPage = PaginationPerPage.Fifty;
    if (pagination.CurrentPage > TotalPages)
    {
      pagination.CurrentPage = TotalPages;
    }
  }

  private void ShowAllPerPageBtn()
  {
    initPerPage = PaginationPerPage.ShowAll;
    if (pagination.CurrentPage > TotalPages)
    {
      pagination.CurrentPage = TotalPages;
    }
  }
  protected override async Task OnInitializedAsync()
  {
    context = DbFactory.CreateDbContext();
    var sQLServerHelper = new SQLServerHelper(context);
    var spParam = SQLServerInnerHelper.ManageAdminProductsWOutputPageParams(functionKey: "PRODUCT_LIST");
    prodList = await sQLServerHelper.ProdListFromSqlAsyncList("rpiAPSM_spManageAdminProductsWOutput", spParam);
    pagination.TotalRecords = prodList.Count;
  }

  private string? dbDataToImg(byte[]? imgBytes)
  {
    if (imgBytes is null || imgBytes.Length == 0)
    {
      return null;
    }
    else
    {
      return $"data:image/png;base64,{Convert.ToBase64String(imgBytes)}";
    }

  }

  private void NextPage()
  {
    if (pagination.CurrentPage < TotalPages)
    {
      pagination.CurrentPage++;
    }
  }

  private void PreviousPage()
  {
    if (pagination.CurrentPage > 1)
    {
      pagination.CurrentPage--;
    }
  }


  private RenderFragment SortIcon(string column) => builder =>
  {
    if (currentSortColumn == column)
    {
      builder.AddContent(0, sortAscending ? "▲" : "▼");
    }
  };

  public class PaginationState
  {
    public int ItemsPerPage
    {
      get
      {
        return initPerPage == PaginationPerPage.ShowAll
        ? TotalRecords
        : (int)initPerPage;
      }
    }
    @* public int ItemsPerPage
        {
            get => (int)initPerPage; set => initPerPage = (PaginationPerPage)value;
        } *@
    public int CurrentPage { get; set; } = 1;

    // Injected or externally set by your page
    public int TotalRecords { get; set; }
  }

  public async ValueTask DisposeAsync() // this is important
  {
    await context.DisposeAsync();
  }
}