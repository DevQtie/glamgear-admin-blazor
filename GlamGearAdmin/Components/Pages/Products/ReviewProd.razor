@page "/products/review-product"
@page "/products/review/{prodId}/product"
@rendermode @(new InteractiveServerRenderMode(prerender: false)) //This resolved the issue with Quill Editor rendering
@using Microsoft.EntityFrameworkCore
@using GlamGearAdmin.Models.SQLServer
@using GlamGearAdmin.Data.SQLServer
@using System.Text.RegularExpressions
@implements IAsyncDisposable
@inject IDbContextFactory<GlamGearAdmin.Data.SQLServer.BlazorSQLServerContext> DbFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Details</PageTitle>

<h3>Review Product</h3>

<script src="lib/customjs/reviewprod.js"></script>

@if (ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview is null)
{
    <div class="position-absolute top-50 start-50 translate-middle">
        <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid overflow-x-auto mw-40">
        <div class="row py-1 border rounded border-secondary-subtle text-center my-1">
            <EditForm EditContext="editContext" OnValidSubmit="UpdateProduct" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <div class="d-flex flex-column align-items-start mb-4">
                    <h5 class="fw-bold py-1">Basic Information</h5>
                    <div class="mb-3 d-flex flex-column align-items-start w-100">
                        <label for="randomText" class="form-label text-nowrap fw-bold">Product Name:</label>
                        <InputText id="randomText"
                            @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.ProdName"
                            class="form-control" />
                        <ValidationMessage
                            For="() => ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.ProdName"
                            class="text-danger" />
                    </div>
                    <div class="mb-3 d-flex flex-column align-items-start w-100">
                        <label for="randomText" class="form-label text-nowrap fw-bold">Product Category:</label>
                        <Dropdown Color="DropdownColor.Light" Size="DropdownSize.Small">
                            <DropdownToggleButton>@(ReviewThenModifyProduct.SelectedCategory ?? "Select a category")
                            </DropdownToggleButton>
                            <DropdownMenu>
                                @foreach (var category in ReviewThenModifyProduct.CompileProductProperties.ProductCategory)
                                {
                                    <DropdownItem @onclick="() => OnCategoryItemSelected(category)" Active="@category.State"
                                        Disabled="@(category.ID == 2 || category.ID == 3)">
                                        @category.Item
                                    </DropdownItem>
                                }
                            </DropdownMenu>
                        </Dropdown>
                    </div>
                    <div class="container m-0 p-0">
                        <div class="row">
                            <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                <label for="randomText" class="form-label text-nowrap fw-bold">Original Price:</label>
                                <InputNumber id="randomText"
                                    @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.OrigPrice"
                                    class="form-control" />
                                <ValidationMessage
                                    For="() => ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.OrigPrice"
                                    class="text-danger" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                <label for="randomText" class="form-label text-nowrap fw-bold">Discounted Price:</label>
                                <InputNumber id="randomText"
                                    @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.DiscPrice"
                                    class="form-control" />
                                <ValidationMessage
                                    For="() => ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.DiscPrice"
                                    class="text-danger" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                <label for="randomText" class="form-label text-nowrap fw-bold">Stock:</label>
                                <InputNumber id="randomText"
                                    @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                    class="form-control" />
                                <ValidationMessage
                                    For="() => ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                    class="text-danger" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                <label for="randomText" class="form-label text-nowrap fw-bold">Availability:</label>
                                <Switch
                                    @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Availability" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 d-flex flex-column align-items-start w-100">
                        <label for="randomText" class="form-label text-nowrap fw-bold">Promo Tags:</label>
                        <div class="suggestion-container w-100">
                            <div id="@($"{Id}_tagsinput")" class="tagsinput">

                                @if (Tags != null && Tags.Any())
                                {
                                    @foreach (var tag in Tags)
                                    {
                                        <span class="tag bg-primary border rounded d-flex flex-column align-items-center">
                                            <span class="tag-text">@tag.TagValues</span>
                                            <span class="tag-remove text-white bg-primary p-0 border rounded-end border-primary"
                                                @onclick="() => DeleteTag(tag.TagValues)" />
                                        </span>
                                    }
                                }

                                <div id="@($"{Id}_addTag")">
                                    <div class="@(IsContainSpecialCharacter ? "tag-tooltip" : string.Empty)">
                                        <input id="@($"{Id}_tag")" class="tag-input" placeholder="Add tags"
                                            autocomplete="off" @bind-value="Value" @bind-value:event="oninput"
                                            @onkeyup="AddTags" />

                                        @if (IsContainSpecialCharacter)
                                        {
                                            <div class="error-right d-inline-flex p-2">
                                                <i class="oi oi-warning text-warning p-1"></i>
                                                <p class="text-left m-0 p-1">Special characters not allowed.</p>
                                                <i></i>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 d-flex flex-column align-items-start w-100">
                        <label for="randomText" class="form-label text-nowrap fw-bold">Product Specifications:</label>
                        
                        <div class="container m-0 p-0">
                            <div class="row">
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                <label for="randomText" class="form-label text-nowrap fw-bold">Diamond Shape:</label>
                                <InputNumber id="randomText"
                                    @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.OrigPrice"
                                    class="form-control" />
                                <ValidationMessage
                                    For="() => ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.OrigPrice"
                                    class="text-danger" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="randomText" class="form-label text-nowrap fw-bold">Material Type:</label>
                                    <InputNumber id="randomText"
                                        @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.DiscPrice"
                                        class="form-control" />
                                    <ValidationMessage
                                        For="() => ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.DiscPrice"
                                        class="text-danger" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="randomText" class="form-label text-nowrap fw-bold">Main Jewelry Stone:</label>
                                    <InputNumber id="randomText"
                                        @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                        class="form-control" />
                                    <ValidationMessage
                                        For="() => ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                        class="text-danger" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="randomText" class="form-label text-nowrap fw-bold">Brand:</label>
                                    <InputNumber id="randomText"
                                        @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                        class="form-control" />
                                    <ValidationMessage
                                        For="() => ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                        class="text-danger" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="randomText" class="form-label text-nowrap fw-bold">Condition:</label>
                                    <InputNumber id="randomText"
                                        @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                        class="form-control" />
                                    <ValidationMessage
                                        For="() => ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                        class="text-danger" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="randomText" class="form-label text-nowrap fw-bold">Warranty Type:</label>
                                    <InputNumber id="randomText"
                                        @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                        class="form-control" />
                                    <ValidationMessage
                                        For="() => ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                        class="text-danger" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="randomText" class="form-label text-nowrap fw-bold">Box Content:</label>
                                    <InputNumber id="randomText"
                                        @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                        class="form-control" />
                                    <ValidationMessage
                                        For="() => ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                        class="text-danger" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="randomText" class="form-label text-nowrap fw-bold">Add spec:</label>
                                    <InputNumber id="randomText"
                                        @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                        class="form-control" />
                                    <ValidationMessage
                                        For="() => ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Stock"
                                        class="text-danger" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="randomText" class="form-label text-nowrap fw-bold">Sort list:</label>
                                    <SortableList TItem="Employee" Data="employees" Context="item" OnUpdate="@OnEmployeeListUpdate">
                                        <ItemTemplate>
                                            @item.Name
                                        </ItemTemplate>
                                    </SortableList>
                                </div>
                            </div>
                        </div>
                    </div>
                    

                    <div class="mb-3 d-flex flex-column align-items-start w-100">
                        <label for="randomText" class="form-label text-nowrap fw-bold">Product Description:</label>
                        <div class="w-100">                            
                            <div id="editor" class="w-100"></div>
                        </div>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private EditContext? editContext;
    private ValidationMessageStore? messageStore;
    private ReviewThenModifyProduct ReviewThenModifyProduct = new ReviewThenModifyProduct();
    private BlazorSQLServerContext context = default!;
    private Guid Id => Guid.NewGuid();
    protected string? Value { get; set; }
    protected bool IsContainSpecialCharacter { get; set; }
    protected List<ProductPromoTagFR> Tags { get; set; } = new();

    [Parameter]
    public string? prodId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(ReviewThenModifyProduct);
        messageStore = new ValidationMessageStore(editContext);

        editContext.OnValidationRequested += HandleValidationRequested;
        context = DbFactory.CreateDbContext();
        await RetrieveProductMainForReview();
        await RetrievePromoTagForReview();
    }

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs e)
    {
        messageStore!.Clear();

        @* if (isModifyUser)
        {
            if (string.IsNullOrWhiteSpace(VerifyRemRoleUser.SelectedRole))
            {
                messageStore.Add(() => VerifyRemRoleUser.SelectedRole!, "Required field.");
            }
        }
        else if (isReevaluateUser)
        {
            // Only validate VerifyRemRoleUser.SelectedRemark if VerifyRemRoleUser.SelectedRole is valid
            if (string.IsNullOrWhiteSpace(VerifyRemRoleUser.SelectedRemark))
            {
                messageStore.Add(() => VerifyRemRoleUser.SelectedRemark!, "Required field.");
            }
        }
        else
        {
            messageStore.Add(() => VerifyRemRoleUser.SelectedRole!, "Required field.");
            messageStore.Add(() => VerifyRemRoleUser.SelectedRemark!, "Required field.");
        } *@
    }

    private async Task RetrieveProductMainForReview()
    {
        var sQLServerHelper = new SQLServerHelper(context);
        ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview = null;
        StateHasChanged();
        var spParam = SQLServerInnerHelper.ManageAdminProductsWOutputPageParams(prodID: prodId, functionKey: "REVIEW_PRODUCT");
        ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview = await
        sQLServerHelper.ProductMainFRFromSqlAsync("rpiAPSM_spManageProductsWOutput", spParam);
        if (ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        StateHasChanged();
    }

    private async Task RetrievePromoTagForReview()
    {
        var sQLServerHelper = new SQLServerHelper(context);
        StateHasChanged();
        var spParam = SQLServerInnerHelper.ManageAdminProductsWOutputPageParams(prodID: prodId, functionKey:
        "REVIEW_PRODUCT_PROMO_TAG");
        Tags = await
        sQLServerHelper.ProductPromoTagFRFromSqlAsyncList("rpiAPSM_spManageProductsWOutput", spParam);
        if (Tags is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        StateHasChanged();
    }

    private async Task UpdateProduct()
    {
        await Task.Delay(1000); // simulate a delay
    }

    private void OnCategoryItemSelected(ProductCategory item)
    {
        ReviewThenModifyProduct.SelectedCategoryID = item.ID;
        ReviewThenModifyProduct.SelectedCategory = item.Item ?? string.Empty;
        SetActiveRole(ReviewThenModifyProduct.SelectedCategoryID);
    }

    private void SetActiveRole(int id)
    {
        foreach (var category in ReviewThenModifyProduct.CompileProductProperties.ProductCategory)
            category.State = category.ID == id;
    }

    protected void AddTags(KeyboardEventArgs eventArgs)
    {
        IsContainSpecialCharacter = false;

        if (!String.IsNullOrEmpty(Value))
        {
            if (eventArgs.Key.Equals("Enter"))
            {
                var regex = new Regex(@"[^a-zA-Z0-9\s]");
                if (!regex.IsMatch(Value))
                {
                    if (!Tags.Exists(t => t.TagValues!.Equals(Value, StringComparison.CurrentCultureIgnoreCase)))
                    {
                        @* Tags.Add(Value); *@
                    }

                    Value = string.Empty;
                }
                else
                {
                    IsContainSpecialCharacter = true;
                }
            }
        }
    }

    protected void DeleteTag(string value)
    {
        if (String.IsNullOrEmpty(value)) return;

        var tag = Tags.FirstOrDefault(t => t.TagValues == value);
        if (tag == null) return;

        Tags.Remove(tag);
    }

    public async ValueTask DisposeAsync() // this is important
    {
        await context.DisposeAsync();
    }


    public List<Employee> employees = Enumerable.Range(1, 5).Select(i => new Employee(i, $"Product specification {i}")).ToList();

    private void OnEmployeeListUpdate(SortableListEventArgs args)
    {
        var itemToMove = employees[args.OldIndex];

        employees.RemoveAt(args.OldIndex);

        if (args.NewIndex < employees.Count)
            employees.Insert(args.NewIndex, itemToMove);
        else
            employees.Add(itemToMove);
    }

    public record Employee(int Id, string? Name);

}