        if (!string.IsNullOrWhiteSpace(request.Filter?.Value))
        {
            query = query.Where(data =>
                data.Tag.Contains(request.Filter.Value, StringComparison.OrdinalIgnoreCase));
        }

        var productTagRef = query
            .Select(data => new ProductTagsRefFRAutoComplete(data.Tag))
            .ToList();

        return await Task.FromResult(new BlazorBootstrap.AutoCompleteDataProviderResult<ProductTagsRefFRAutoComplete>
        {
            Data = productTagRef,
            TotalCount = productTagRef.Count
        });
    }

