    private async Task HandleProductImageUpload(InputFileChangeEventArgs e)
    {
        const long maxAllowedSize = 3L * 1024L * 1024L; //3 MB limit
        const int maxFileCount = 8;
        try
        {
        int getItemPostCount = ReviewThenModifyProduct.CompileProductProperties.ProductImages.Count;
        int getItemPreCount = e.GetMultipleFiles(maxFileCount).Count() + getItemPostCount;
        if (getItemPostCount != 0 && maxFileCount < getItemPreCount)
        {
            errorMessage = "The max allowed count of items was exceeded.";
            await JS.InvokeVoidAsync("showLiveToastError");
        }
        else
        {
            foreach (var file in e.GetMultipleFiles(maxFileCount))
            {
                using var readStream = file.OpenReadStream(maxAllowedSize);
                using var memoryStream = new MemoryStream();

                await readStream.CopyToAsync(memoryStream);
                @* var base64 = Convert.ToBase64String(memoryStream.ToArray()); *@
                
                string pImgID = Guid.NewGuid().ToString().Replace("-", "").ToUpper();
                int getLength = pImgID.Count();
                string reprocessedStringID = "";
                string dateNow = DateTime.Now.ToString("yyyy-MM-dd");
                for (int i = 0; i <= getLength; i++)
                {
                    if (i < 13)
                    {
                        reprocessedStringID = pImgID.Substring(0, i);
                        if (i == 12)
                        {
                            break;
                        }
                    }
                }
                string concatString = String.Concat("PROD_PT-", dateNow, "-", reprocessedStringID);
                ReviewThenModifyProduct.CompileProductProperties.ProductImages.Add(
                    new ProductImgFR
                    {
                        ProdID = concatString,
                        ProdImg = memoryStream.ToArray(),
                        Size = file.Size
                    }
                );
            }
            @* ReviewThenModifyProduct.CompileProductProperties.ProductImages.Reverse(); *@
        }
        }
        catch (IOException ex)
        {
            errorMessage = ex.Message;
            ReviewThenModifyProduct.CompileProductProperties.ProductImages.Clear();
            await JS.InvokeVoidAsync("showLiveToastError");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            ReviewThenModifyProduct.CompileProductProperties.ProductImages.Clear();
            await JS.InvokeVoidAsync("showLiveToastError");
        }
    }

    protected void DeleteImage(string? value)
    {
        if (String.IsNullOrEmpty(value)) return;

        var prodImg = ReviewThenModifyProduct.CompileProductProperties.ProductImages.FirstOrDefault(img => img.ProdID == value);
        if (prodImg == null) return;

        ReviewThenModifyProduct.CompileProductProperties.ProductImages.Remove(prodImg);
    }

    private void OnProdSpecsListUpdate(SortableListEventArgs args)
    {
        var itemToMove = productSpecs[args.OldIndex];

        productSpecs.RemoveAt(args.OldIndex);

        if (args.NewIndex < productSpecs.Count)
            productSpecs.Insert(args.NewIndex, itemToMove);
        else
            productSpecs.Add(itemToMove);
    }

