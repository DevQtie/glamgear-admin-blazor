    protected void AddTags(KeyboardEventArgs eventArgs) // for reference only
    {
        IsContainSpecialCharacter = false;

        if (!String.IsNullOrEmpty(Value))
        {
            if (eventArgs.Key.Equals("Enter"))
            {
                var regex = new Regex(@"[^a-zA-Z0-9\s]");
                if (!regex.IsMatch(Value))
                {
                    if (!ReviewThenModifyProduct.CompileProductProperties.Tags.Exists(t => t.TagValues!.Equals(Value, StringComparison.CurrentCultureIgnoreCase)))
                    {
                        @* Tags.Add(Value); *@
                    }

                    Value = string.Empty;
                }
                else
                {
                    IsContainSpecialCharacter = true;
                }
            }
        }
    }

    protected void DeleteTag(string value)
    {
        if (String.IsNullOrEmpty(value)) return;

        var tag = ReviewThenModifyProduct.CompileProductProperties.Tags.FirstOrDefault(t => t.TagValues == value);
        if (tag == null) return;

        ReviewThenModifyProduct.CompileProductProperties.Tags.Remove(tag);
        
        var fieldTag = editContext!.Field(nameof(ReviewThenModifyProduct.CompileProductProperties.Tags));
        var fieldTagRef = editContext!.Field(nameof(ReviewThenModifyProduct.TagRef));
        messageStore?.Clear(fieldTag);
        messageStore?.Clear(fieldTagRef);
        if (ReviewThenModifyProduct.CompileProductProperties.Tags.Count == 0)
        {            
            messageStore!.Add(() => ReviewThenModifyProduct.CompileProductProperties.Tags, "Add at least one promotional tag.");
        }
    }

