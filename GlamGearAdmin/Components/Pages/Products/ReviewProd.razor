                                                    <img src="@GlobalMethod.DbDataToImg(img.ProdImg)" class="img-thumbnail m-3" width="150px" alt="Product Image" />                                            
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
