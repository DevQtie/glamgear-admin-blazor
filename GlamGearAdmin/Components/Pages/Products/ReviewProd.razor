@page "/products/review-product"
@page "/products/review/{prodId}/product"
@* @rendermode @(new InteractiveServerRenderMode(prerender: false)) //This resolved the issue with Quill Editor rendering *@
@* @rendermode InteractiveAuto *@
@* @rendermode InteractiveServer *@
@rendermode @(new InteractiveAutoRenderMode(prerender: false)) //This also resolved the issue with Quill Editor rendering
@using Microsoft.EntityFrameworkCore
@using GlamGearAdmin.Models.SQLServer
@using GlamGearAdmin.Data.SQLServer
@using System.Text.RegularExpressions
@using System.Globalization
@using MudBlazor
@* @implements IAsyncDisposable *@
@inject IDbContextFactory<GlamGearAdmin.Data.SQLServer.BlazorSQLServerContext> DbFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Details</PageTitle>

<h3>Review Product</h3>

<script src="lib/customjs/reviewprod.js"></script>

@if (!isReviewSummary)
{
    @if (ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview is null)
    {
        <div class="position-absolute top-50 start-50 translate-middle">
            <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
    @* <a class="btn btn-primary my-3" @onclick="ButtonClicked">Image Simulation</a> *@
        <div class="container-fluid overflow-x-auto mw-40">
            <div class="row py-1 border rounded border-secondary-subtle text-center my-2">
                <EditForm method="post" EditContext="editContext" OnValidSubmit="ReviewProduct" FormName="edit" Enhance>
                    <FluentValidationValidator />
                    @* <DataAnnotationsValidator /> *@
                    <div class="d-flex flex-column align-items-start mb-4">
                        <h5 class="fw-bold py-1">Basic Information</h5>
                        <div class="mb-3 d-flex flex-column align-items-start w-100">
                            <label for="prodName" class="form-label text-nowrap fw-bold">Product Name</label>
                            <div class="d-flex flex-column align-items-end w-100">
                                <InputText id="prodName" class="form-control form-control-sm" maxlength="255"
                                    @bind-Value="ReviewThenModifyProduct.ProdNameEntry" @oninput="OnInputProdName" @onblur="FormatOnBlurProdName" />
                                <p class="text-muted small m-0 mt-1">
                                    @($"{ReviewThenModifyProduct.ProdNameLC} / 255 characters")
                                </p>
                            </div>
                            <ValidationMessage
                                For="() => ReviewThenModifyProduct.ProdNameEntry"
                                class="text-danger" />
                        </div>
                        <div class="container m-0 p-0">
                            <div class="row">
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                  <label for="prodCat" class="form-label text-nowrap fw-bold">Product Category</label>
                                  <BlazorBootstrap.Dropdown Id="prodCat" Color="BlazorBootstrap.DropdownColor.Light" Size="BlazorBootstrap.DropdownSize.Small">
                                      <BlazorBootstrap.DropdownToggleButton>@(ReviewThenModifyProduct.SelectedCategory ?? "Select a category")
                                      </BlazorBootstrap.DropdownToggleButton>
                                      <BlazorBootstrap.DropdownMenu>
                                          @foreach (var category in ReviewThenModifyProduct.CompileProductProperties.ProductCategory)
                                          {
                                              <BlazorBootstrap.DropdownItem @onclick="() => OnCategoryItemSelected(category)" Active="@category.State"
                                                  Disabled="@(category.ID == 2 || category.ID == 3)">
                                                  @category.Item
                                              </BlazorBootstrap.DropdownItem>
                                          }
                                      </BlazorBootstrap.DropdownMenu>
                                  </BlazorBootstrap.Dropdown>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="origPrice" class="form-label text-nowrap fw-bold">Original Price</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">₱</span>
                                        <InputText id="origPrice"
                                            @bind-Value="ReviewThenModifyProduct.FormattedOrigPrice"
                                            class="form-control form-control-sm" @onblur="FormatOnBlurOrigPrice"/>
                                        <ValidationMessage
                                            For="() => ReviewThenModifyProduct.FormattedOrigPrice"
                                            class="text-danger py-1" />
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="discPrice" class="form-label text-nowrap fw-bold">Discounted Price</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">₱</span>
                                        <InputText id="discPrice"
                                            @bind-Value="ReviewThenModifyProduct.FormattedDiscPrice"
                                            class="form-control form-control-sm" @onblur="FormatOnBlurDiscPrice" />
                                        <ValidationMessage
                                            For="() => ReviewThenModifyProduct.FormattedDiscPrice"
                                            class="text-danger py-1" />
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="diffPrice" class="form-label text-nowrap fw-bold">Difference Price</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">₱</span>
                                        <input id="diffPrice" type="text"
                                        class="form-control form-control-sm"
                                        value="@ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.DiffPrice"
                                        readonly />
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="roundedDP" class="form-label text-nowrap fw-bold">Rounded Discount Percentage</label>
                                    <div class="input-group input-group-sm">
                                        <input id="roundedDP" type="text"
                                        class="form-control form-control-sm"
                                        value="@($"{ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.RoundedDiscPercentage}%")"
                                        readonly />
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="stock" class="form-label text-nowrap fw-bold">Stock</label>
                                    <InputNumber id="stock"
                                        @bind-Value="ReviewThenModifyProduct.ProdStock"
                                        class="form-control form-control-sm" @oninput="OnInputProdStock" @onblur="FormatOnBlurProdStock" />
                                    <ValidationMessage
                                        For="() => ReviewThenModifyProduct.ProdStock"
                                        class="text-danger" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="avSwitch" class="form-label text-nowrap fw-bold">Availability</label>
                                    <BlazorBootstrap.Switch id="avSwitch"
                                        @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Availability" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 d-flex flex-column align-items-start w-100">
                            <label for="promoTag" class="form-label text-nowrap fw-bold">Promo Tags</label>                        
                            <div class="suggestion-container d-flex flex-column align-items-start w-100">
                                <div id="@($"{Id}_tagsinput")" class="tagsinput w-100">

                                    @if (ReviewThenModifyProduct.CompileProductProperties.Tags == null)
                                    {
                                        @*<div class="position-absolute top-50 start-50 translate-middle">
                                            <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </div> Replace this with shimmer instead; need improvements*@
                                    }
                                    else if (ReviewThenModifyProduct.CompileProductProperties.Tags.Count == 0)
                                    {
                                        @*<div class="position-absolute top-50 start-50 translate-middle">
                                            <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </div> Replace this with shimmer instead; need improvements*@
                                    }
                                    else
                                    {
                                        @foreach (var tag in ReviewThenModifyProduct.CompileProductProperties.Tags)
                                        {
                                            <span class="tag bg-primary border rounded d-flex flex-column align-items-center">
                                                <span class="tag-text">@tag.TagValues</span>
                                                <span class="tag-remove text-white bg-primary p-0 border rounded-end border-primary"
                                                    @onclick="() => DeleteTag(tag.TagValues)" />
                                            </span>
                                        }
                                    }

                                    <div id="@($"{Id}_addTag")">
                                        <div class="@(IsContainSpecialCharacter ? "tag-tooltip" : string.Empty)">
                                            @* <input id="@($"{Id}_tag")" class="tag-input" placeholder="Add tags"
                                                autocomplete="off" @bind-value="Value" @bind-value:event="oninput"
                                                @onkeyup="AddTags" /> *@
                                            @*Note: The behavior of having cleared input upon focus removal is by design*@
                                            <BlazorBootstrap.AutoComplete @bind-Value="ReviewThenModifyProduct.TagRef"
                                                id="promoTag"
                                                Class="tag-input border-0"
                                                TItem="ProductTagsRefFRAutoComplete"
                                                DataProvider="ProductTagRefDataProvider"
                                                PropertyName="Tag"
                                                Placeholder="Search a tag..."
                                                Size="BlazorBootstrap.AutoCompleteSize.Small"
                                                OnChanged="(ProductTagsRefFRAutoComplete tag) => OnAutoCompleteChanged(tag)" />
                                        </div>
                                    </div>
                                </div>
                                <ValidationMessage For="@(() => ReviewThenModifyProduct.TagRef)" class="text-danger py-1" /> @*Kindly review what's going on here*@
                                <ValidationMessage For="@(() => ReviewThenModifyProduct.CompileProductProperties.Tags)" class="text-danger py-1" /> @*Kindly review what's going on here*@
                            </div>
                        </div>

                        <div class="mb-3 d-flex flex-column align-items-start w-100">
                            <label for="prodImg" class="form-label text-nowrap fw-bold">Product Images
                                <BlazorBootstrap.Tooltip Class="ps-1"
                                    data-bs-html="true"
                                    Title="@ReviewThenModifyProduct.ImageNotes"
                                    Placement="BlazorBootstrap.TooltipPlacement.Right">
                                    <BlazorBootstrap.Icon Name="BlazorBootstrap.IconName.InfoCircle" Color="BlazorBootstrap.IconColor.Info" />
                                </BlazorBootstrap.Tooltip>
                                @* <a data-bs-toggle="tooltip" datab-bs-placement="right" data-bs-html="true" data-bs-title="@ReviewThenModifyProduct.ImageNotes">
                                    <Icon Name="IconName.InfoCircle" Color="IconColor.Info" />
                                </a> has issues *@
                            </label>
                            <div class="container-fluid p-0">
                            <div class="column">
                                <div class="col-12 col-lg-12 mb-3">
                                    @if (ReviewThenModifyProduct.CompileProductProperties.ProductImages == null)
                                    {                                        
                                        @*<div class="position-absolute top-50 start-50 translate-middle">
                                            <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </div> Replace this with shimmer instead*@
                                        <InputFile @ref="filePicker" class="btn btn-outline-primary my-1 d-none" OnChange="HandleProductImageUpload" accept="image/*"
                                            multiple />
                                        <button id="prodImg" class="btn btn-primary rounded-circle"
                                                style="width: 40px; height: 40px;"
                                                @onclick="TriggerFileUpload"
                                                title="Upload Image">
                                            @* <i class="bi bi-camera"></i> *@
                                            <BlazorBootstrap.Icon Name="BlazorBootstrap.IconName.Images" Color="BlazorBootstrap.IconColor.White" />
                                        </button>
                                        @* <ValidationMessage For="() => ReviewThenModifyProduct.CompileProductProperties.ProductImages" class="text-danger" /> *@
                                    }
                                    else
                                    {
                                        int totalCount = ReviewThenModifyProduct.CompileProductProperties.ProductImages?.Count ?? 0;
                                        int counter = 0;
                                        @*The code can be optimized*@
                                        if (totalCount == 0)
                                        {
                                            <InputFile @ref="filePicker" class="btn btn-outline-primary my-1 d-none" OnChange="HandleProductImageUpload" accept="image/*"
                                                multiple />
                                            <button class="btn btn-primary rounded-circle"
                                                    style="width: 40px; height: 40px;"
                                                    @onclick="TriggerFileUpload"
                                                    title="Upload Image">
                                                @* <i class="bi bi-camera"></i> *@
                                                <BlazorBootstrap.Icon Name="BlazorBootstrap.IconName.Images" Color="BlazorBootstrap.IconColor.White" />
                                            </button>
                                            <ValidationMessage For="() => ReviewThenModifyProduct.CompileProductProperties.ProductImages" class="text-danger" />

                                        }
                                        else
                                        {
                                            @foreach (var img in ReviewThenModifyProduct.CompileProductProperties.ProductImages!)
                                            {
                                                counter++;
                                                <div class="position-relative d-inline-block">
                                                    <a href="@GlobalMethod.DbDataToImg(img.ProdImg)" target="_blank"> @* TODO: Fix the needing of refreshing the page to show the image in target="_blank" *@
                                                        <img src="@GlobalMethod.DbDataToImg(img.ProdImg)" class="img-thumbnail m-3" width="200px" alt="Product Image" />                                            
                                                    </a>
                                                    <button type="button"
                                                        class="btn btn-cust btn-sm fs-3 text-white rounded-circle position-absolute top-0 end-0 m-1 me-4 mt-2"
                                                        title="Remove image"
                                                        @onclick="() => DeleteImage(img.ProdID)">
                                                        &times;
                                                    </button>
                                                </div>
                                                if (totalCount == counter)
                                                {
                                                    <InputFile @ref="filePicker" class="btn btn-outline-primary my-1 d-none" OnChange="HandleProductImageUpload" accept="image/*"
                                                        multiple />
                                                    <button class="btn btn-primary rounded-circle"
                                                            style="width: 40px; height: 40px;"
                                                            @onclick="TriggerFileUpload"
                                                            title="Upload Image">
                                                        @* <i class="bi bi-camera"></i> *@
                                                        <BlazorBootstrap.Icon Name="BlazorBootstrap.IconName.Images" Color="BlazorBootstrap.IconColor.White" />
                                                    </button>
                                                    <ValidationMessage For="() => ReviewThenModifyProduct.CompileProductProperties.ProductImages" class="text-danger" />
                                                }
                                            }
                                        }
                                    }
                                </div>
                            </div>
                            </div>
                        </div>

                        <div class="mb-3 d-flex flex-column align-items-start w-100">
                            <label for="@($"{ReviewThenModifyProduct.CompileProductProperties.ProductSpecs.First().KeyNameID}")" class="form-label text-nowrap fw-bold">Product Specifications</label>
                            
                            <div class="container m-0 p-0">
                                <div class="row">
                                    @if (ReviewThenModifyProduct.CompileProductProperties.ProductSpecs.Count == 0)
                                    {
                                        <div class="position-absolute top-50 start-50 translate-middle">
                                            <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var specs in ReviewThenModifyProduct.CompileProductProperties.ProductSpecs)
                                        {
                                            @if (specs.KeyName!.Contains("Warranty Type", StringComparison.CurrentCultureIgnoreCase))
                                            {
                                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                                    <label for="@($"{specs.KeyNameID}")" class="form-label text-nowrap fw-bold">@($"{specs.KeyName}")</label>
                                                    <BlazorBootstrap.Dropdown Id="@($"{specs.KeyNameID}")" Color="BlazorBootstrap.DropdownColor.Light" Size="BlazorBootstrap.DropdownSize.Small" Class="w-100">
                                                        <BlazorBootstrap.DropdownToggleButton>@(ReviewThenModifyProduct.SelectedWarrantyType ?? "Select a warranty type")
                                                        </BlazorBootstrap.DropdownToggleButton>
                                                        <BlazorBootstrap.DropdownMenu Class="w-100">
                                                            @foreach (var warrantyType in ReviewThenModifyProduct.CompileProductProperties.ProductWarrantyType)
                                                            {
                                                                <BlazorBootstrap.DropdownItem @onclick="() => OnWarrantyTypeItemSelected(warrantyType)" Active="@warrantyType.State"
                                                                    Disabled="@(warrantyType.ID == 2)" Class="w-100">
                                                                    @warrantyType.Item
                                                                </BlazorBootstrap.DropdownItem>
                                                            }
                                                        </BlazorBootstrap.DropdownMenu>
                                                    </BlazorBootstrap.Dropdown>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                                    <label for="@($"{specs.KeyNameID}")" class="form-label text-nowrap fw-bold">@($"{specs.KeyName}")</label>
                                                    <InputText id="@($"{specs.KeyNameID}")"
                                                        @bind-Value="specs.Value"
                                                        @onblur="FormatOnBlurSpecs"
                                                        class="form-control form-control-sm" />
                                                    <ValidationMessage id="@($"{specs.KeyNameID}")"
                                                        For="() => specs.Value"
                                                        class="text-danger" />
                                                </div>
                                            }
                                        }
                                    }
                                    <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                        <label for="randomText" class="form-label text-nowrap fw-bold">Sort list</label>
                                        @*This feature is to rank the product specifications based on their character length (ascending). TODO: add functionality and save to database*@
                                        <BlazorBootstrap.SortableList TItem="ProductSpecsFRSort" Data="productSpecs" Context="item" OnUpdate="@OnProdSpecsListUpdate">
                                            <ItemTemplate>
                                                @item.Value
                                            </ItemTemplate>
                                        </BlazorBootstrap.SortableList>
                                    </div>
                                </div>
                            </div>
                        </div>                    

                        <div class="mb-3 d-flex flex-column align-items-start w-100">
                            <label for="editor" class="form-label text-nowrap fw-bold">Product Description</label>
                            <div class="w-100">
                                @*For reference: https://quilljs.com/docs/quickstart*@
                                @*<div id="editor" class="w-100 rounded-bottom"></div> Could be replaced with https://demos.blazorbootstrap.com/markdown if the images were accessible through a link.*@
                                <div id="toolbar-container">
                                    <span class="ql-formats">
                                        <select class="ql-font">
                                            <option selected>Sans Serif</option>
                                            <option value="roboto">Roboto</option>
                                            <option value="open sans">Open Sans</option>
                                            <option value="lato">Lato</option>
                                            <option value="montserrat">Montserrat</option>
                                            <option value="roboto condensed">Roboto Condensed</option>
                                            <option value="oswald">Oswald</option>
                                            <option value="poppins">Poppins</option>
                                            <option value="slabo 27px">Slabo 27px</option>
                                            <option value="noto sans">Noto Sans</option>
                                            <option value="roboto mono">Roboto Mono</option>
                                            <option value="merriweather">Merriweather</option>
                                        </select>
                                        <select class="ql-size"></select>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-bold"></button>
                                        <button class="ql-italic"></button>
                                        <button class="ql-underline"></button>
                                        <button class="ql-strike"></button>
                                    </span>
                                    <span class="ql-formats">
                                        <select class="ql-color"></select>
                                        <select class="ql-background"></select>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-script" value="sub"></button>
                                        <button class="ql-script" value="super"></button>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-header" value="1"></button>
                                        <button class="ql-header" value="2"></button>
                                        <button class="ql-blockquote"></button>
                                        <button class="ql-code-block"></button>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-list" value="ordered"></button>
                                        <button class="ql-list" value="bullet"></button>
                                        <button class="ql-indent" value="-1"></button>
                                        <button class="ql-indent" value="+1"></button>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-direction" value="rtl"></button>
                                        <select class="ql-align"></select>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-link"></button>
                                        <button class="ql-image"></button>
                                        <button class="ql-video"></button>
                                        <button class="ql-formula"></button>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-clean"></button>
                                    </span>
                                </div>
                                <div id="editor" @onblur="FormatOnBlurQuill">
                                </div>
                                <div class="w-100 d-flex align-items-start">
                                    @if (ReviewThenModifyProduct.CompileProductProperties.ProductDescription != null)
                                    {
                                        <ValidationMessage For="() => ReviewThenModifyProduct.CompileProductProperties.ProductDescription.Description" class="text-danger" />
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="row py-1 text-center m-0 w-100">
                            <div class="col-6 d-flex flex-column justify-content-center align-items-center ps-0">
                                <button type="submit" class="btn btn-primary w-100 text-wrap">Review Product Details Entry</button>
                            </div>
                            <div class="col-6 d-flex flex-column justify-content-center align-items-center pe-0">
                                <button type="button"
                                    class="btn btn-outline-danger w-100 text-wrap" @onclick="NavigateBack">Go Back</button>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }
}
else
{
    @*Should not proceed if a field is left blank*@
    <div class="container-fluid overflow-x-auto mw-40">
        <div class="row py-1 border rounded border-secondary-subtle my-2">
            <div class="d-flex flex-column align-items-start mb-4">
                <h5 class="fw-bold py-1">Basic Information</h5>
                <div class="d-flex flex-column justify-content-center py-1 w-100">                    
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-6 d-flex flex-column justify-content-start align-items-start ps-0">
                                <div class="container m-0 p-0">
                                    <div class="row">
                                        <div class="col-12 col-sm-6 col-lg-4 mb-3 d-flex flex-column align-items-start">
                                            <label class="form-label text-nowrap fw-bold">Product Name</label>
                                            <p>@ReviewThenModifyProduct.ProdNameEntry</p>
                                        </div>
                                        <div class="col-12 col-sm-6 col-lg-4 mb-3 d-flex flex-column align-items-start">
                                            <label class="form-label text-wrap fw-bold">Product Category</label>
                                            <p>@ReviewThenModifyProduct.SelectedCategory</p>
                                        </div>
                                        <div class="col-12 col-sm-6 col-lg-4 mb-3 d-flex flex-column align-items-start">
                                            <label class="form-label text-wrap fw-bold">Original Price</label>
                                            <p>@ReviewThenModifyProduct.FormattedOrigPrice</p>
                                        </div>
                                        <div class="col-12 col-sm-6 col-lg-4 mb-3 d-flex flex-column align-items-start">
                                            <label class="form-label text-wrap fw-bold">Discounted Price</label>
                                            <p>@ReviewThenModifyProduct.FormattedDiscPrice</p>
                                        </div>
                                        <div class="col-12 col-sm-6 col-lg-4 mb-3 d-flex flex-column align-items-start">
                                            <label class="form-label text-wrap fw-bold">Difference Price</label>
                                            <p>@ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview?.DiffPrice</p>
                                        </div>
                                        <div class="col-12 col-sm-6 col-lg-4 mb-3 d-flex flex-column align-items-start">
                                            <label class="form-label text-wrap fw-bold">Rounded Discount Percentage</label>
                                            <p>@($"{ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview?.RoundedDiscPercentage}%")</p>
                                        </div>
                                        <div class="col-12 col-sm-6 col-lg-4 mb-3 d-flex flex-column align-items-start">
                                            <label for="stock" class="form-label text-wrap fw-bold">Stock</label>
                                            <p>@ReviewThenModifyProduct.ProdStock</p>
                                        </div>
                                        <div class="col-12 col-sm-6 col-lg-4 mb-3 d-flex flex-column align-items-start">
                                            <label for="stock" class="form-label text-wrap fw-bold">Availability</label>
                                            @if (ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview?.Availability == null)
                                            {
                                                <BlazorBootstrap.Tooltip Title="Availability cannot be null." Placement="BlazorBootstrap.TooltipPlacement.Bottom">
                                                    <BlazorBootstrap.Icon Name="BlazorBootstrap.IconName.Bug" Color="BlazorBootstrap.IconColor.Danger" />
                                                </BlazorBootstrap.Tooltip>
                                            }
                                            else
                                            {
                                                @if (ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview?.Availability == true)
                                                {
                                                    <BlazorBootstrap.Tooltip Title="The product is now available." Placement="BlazorBootstrap.TooltipPlacement.Bottom">
