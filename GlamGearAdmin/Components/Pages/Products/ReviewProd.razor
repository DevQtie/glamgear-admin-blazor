@page "/products/review-product"
@page "/products/review/{prodId}/product"
@* @rendermode @(new InteractiveServerRenderMode(prerender: false)) //This resolved the issue with Quill Editor rendering *@
@* @rendermode InteractiveAuto *@
@* @rendermode InteractiveServer *@
@rendermode @(new InteractiveAutoRenderMode(prerender: false)) //This also resolved the issue with Quill Editor rendering
@using Microsoft.EntityFrameworkCore
@using GlamGearAdmin.Models.SQLServer
@using GlamGearAdmin.Data.SQLServer
@using System.Text.RegularExpressions
@using System.Globalization
@implements IAsyncDisposable
@inject IDbContextFactory<GlamGearAdmin.Data.SQLServer.BlazorSQLServerContext> DbFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Details</PageTitle>

<h3>Review Product</h3>

<script src="lib/customjs/reviewprod.js"></script>

@if (ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview is null)
{
    <div class="position-absolute top-50 start-50 translate-middle">
        <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
  @* <a class="btn btn-primary my-3" @onclick="ButtonClicked">Image Simulation</a> *@
    <div class="container-fluid overflow-x-auto mw-40">
        <div class="row py-1 border rounded border-secondary-subtle text-center my-2">
            <EditForm EditContext="editContext" OnValidSubmit="UpdateProduct" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <div class="d-flex flex-column align-items-start mb-4">
                    <h5 class="fw-bold py-1">Basic Information</h5>
                    <div class="mb-3 d-flex flex-column align-items-start w-100">
                        <label for="randomText" class="form-label text-nowrap fw-bold">Product Name</label>
                        <div class="d-flex flex-column align-items-end w-100">
                            <InputText id="randomText" class="form-control form-control-sm" maxlength="255"
                                @bind-Value="ReviewThenModifyProduct.ProdNameEntry" @oninput="OnInputProdName" @onblur="FormatOnBlurProdName" />
                            <p class="text-muted small m-0 mt-1">
                                @($"{ReviewThenModifyProduct.ProdNameLC} / 255 characters")
                            </p>
                        </div>
                        <ValidationMessage
                            For="() => ReviewThenModifyProduct.ProdNameEntry"
                            class="text-danger" />
                    </div>
                    <div class="container m-0 p-0">
                        <div class="row">
                            <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                            <label for="randomText" class="form-label text-nowrap fw-bold">Product Category</label>
                            <Dropdown Color="DropdownColor.Light" Size="DropdownSize.Small">
                                <DropdownToggleButton>@(ReviewThenModifyProduct.SelectedCategory ?? "Select a category")
                                </DropdownToggleButton>
                                <DropdownMenu>
                                    @foreach (var category in ReviewThenModifyProduct.CompileProductProperties.ProductCategory)
                                    {
                                        <DropdownItem @onclick="() => OnCategoryItemSelected(category)" Active="@category.State"
                                            Disabled="@(category.ID == 2 || category.ID == 3)">
                                            @category.Item
                                        </DropdownItem>
                                    }
                                </DropdownMenu>
                            </Dropdown>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                <label for="randomText" class="form-label text-nowrap fw-bold">Original Price</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">₱</span>
                                    <InputText id="randomText"
                                        @bind-Value="ReviewThenModifyProduct.FormattedOrigPrice"
                                        class="form-control form-control-sm" @onblur="FormatOnBlurOrigPrice"/>
                                    <ValidationMessage
                                        For="() => ReviewThenModifyProduct.FormattedOrigPrice"
                                        class="text-danger py-1" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                <label for="randomText" class="form-label text-nowrap fw-bold">Discounted Price</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">₱</span>
                                    <InputText id="randomText"
                                        @bind-Value="ReviewThenModifyProduct.FormattedDiscPrice"
                                        class="form-control form-control-sm" @onblur="FormatOnBlurDiscPrice" />
                                    <ValidationMessage
                                        For="() => ReviewThenModifyProduct.FormattedDiscPrice"
                                        class="text-danger py-1" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                <label for="randomText" class="form-label text-nowrap fw-bold">Stock</label>
                                <InputNumber id="randomText"
                                    @bind-Value="ReviewThenModifyProduct.ProdStock"
                                    class="form-control form-control-sm" @oninput="OnInputProdStock" @onblur="FormatOnBlurProdStock" />
                                <ValidationMessage
                                    For="() => ReviewThenModifyProduct.ProdStock"
                                    class="text-danger" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                <label for="randomText" class="form-label text-nowrap fw-bold">Availability</label>
                                <Switch
                                    @bind-Value="ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview.Availability" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 d-flex flex-column align-items-start w-100">
                        <label for="randomText" class="form-label text-nowrap fw-bold">Promo Tags</label>                        
                        <div class="suggestion-container d-flex flex-column align-items-start w-100">
                            <div id="@($"{Id}_tagsinput")" class="tagsinput w-100">

                                @if (ReviewThenModifyProduct.CompileProductProperties.Tags.Count == 0)
                                {
                                    <div class="position-absolute top-50 start-50 translate-middle">
                                        <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var tag in ReviewThenModifyProduct.CompileProductProperties.Tags)
                                    {
                                        <span class="tag bg-primary border rounded d-flex flex-column align-items-center">
                                            <span class="tag-text">@tag.TagValues</span>
                                            <span class="tag-remove text-white bg-primary p-0 border rounded-end border-primary"
                                                @onclick="() => DeleteTag(tag.TagValues)" />
                                        </span>
                                    }
                                }

                                <div id="@($"{Id}_addTag")">
                                    <div class="@(IsContainSpecialCharacter ? "tag-tooltip" : string.Empty)">
                                        @* <input id="@($"{Id}_tag")" class="tag-input" placeholder="Add tags"
                                            autocomplete="off" @bind-value="Value" @bind-value:event="oninput"
                                            @onkeyup="AddTags" /> *@
                                        <AutoComplete @bind-Value="ReviewThenModifyProduct.TagRef"
                                            id="@($"{Id}_tag")"
                                            Class="tag-input border-0"
                                            TItem="ProductTagsRefFRAutoComplete"
                                            DataProvider="ProductTagRefDataProvider"
                                            PropertyName="Tag"
                                            Placeholder="Search a tag..."
                                            Size="AutoCompleteSize.Small"
                                            OnChanged="(ProductTagsRefFRAutoComplete tag) => OnAutoCompleteChanged(tag)" />
                                    </div>
                                </div>
                            </div>
                            <ValidationMessage For="@(() => ReviewThenModifyProduct.TagRef)" class="text-danger py-1" />
                            <ValidationMessage For="@(() => ReviewThenModifyProduct.CompileProductProperties.Tags)" class="text-danger py-1" />
                        </div>
                    </div>

                    <div class="mb-3 d-flex flex-column align-items-start w-100">
                        <label for="randomText" class="form-label text-nowrap fw-bold">Product Images
                            <Tooltip Class="ps-1"
                                data-bs-html="true"
                                Title="@ReviewThenModifyProduct.ImageNotes"
                                Placement="TooltipPlacement.Right">
                                <Icon Name="IconName.InfoCircle" Color="IconColor.Info" />
                            </Tooltip>
                            @* <a data-bs-toggle="tooltip" datab-bs-placement="right" data-bs-html="true" data-bs-title="@ReviewThenModifyProduct.ImageNotes">
                                <Icon Name="IconName.InfoCircle" Color="IconColor.Info" />
                            </a> has issues *@
                        </label>
                        <div class="container-fluid p-0">
                        <div class="column">
                            <div class="col-12 col-lg-12 mb-3">
                                @if (ReviewThenModifyProduct.CompileProductProperties.ProductImages.Count == 0)
                                {
                                    @* <div class="position-absolute top-50 start-50 translate-middle">
                                        <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div> *@
                                    <InputFile @ref="filePicker" class="btn btn-outline-primary my-1 d-none" OnChange="HandleProductImageUpload" accept="image/*"
                                        multiple />
                                    <button class="btn btn-primary rounded-circle"
                                            style="width: 40px; height: 40px;"
                                            @onclick="TriggerFileUpload"
                                            title="Upload Image">
                                        @* <i class="bi bi-camera"></i> *@
                                        <Icon Name="IconName.Images" Color="IconColor.White" />
                                    </button>
                                    <ValidationMessage For="() => ReviewThenModifyProduct.CompileProductProperties.ProductImages" class="text-danger" />
                                }
                                else
                                {
                                    int totalCount = ReviewThenModifyProduct.CompileProductProperties.ProductImages.Count;
                                    int counter = 0;
                                    @foreach (var img in ReviewThenModifyProduct.CompileProductProperties.ProductImages)
                                    {
                                        counter++;
                                        <div class="position-relative d-inline-block">
                                            <a href="@GlobalMethod.DbDataToImg(img.ProdImg)" target="_blank">
                                                <img src="@GlobalMethod.DbDataToImg(img.ProdImg)" class="img-thumbnail m-3" width="200px" alt="Product Image" />                                            
                                            </a>
                                            <button type="button"
                                                class="btn btn-cust btn-sm fs-3 text-white rounded-circle position-absolute top-0 end-0 m-1 me-3 mt-2"
                                                title="Remove image"
                                                @onclick="() => DeleteImage(img.ProdID)">
                                                &times;
                                            </button>
                                        </div>
                                        @if (counter == totalCount)
                                        {
                                            <InputFile @ref="filePicker" class="btn btn-outline-primary my-1 d-none" OnChange="HandleProductImageUpload" accept="image/*"
                                                multiple />
                                            <button class="btn btn-primary rounded-circle"
                                                    style="width: 40px; height: 40px;"
                                                    @onclick="TriggerFileUpload"
                                                    title="Upload Image">
                                                @* <i class="bi bi-camera"></i> *@
                                                <Icon Name="IconName.Images" Color="IconColor.White" />
                                            </button>
                                            <ValidationMessage For="() => ReviewThenModifyProduct.CompileProductProperties.ProductImages" class="text-danger" />
                                        }
                                    }
                                }
                            </div>
                        </div>
                        </div>
                    </div>

                    <div class="mb-3 d-flex flex-column align-items-start w-100">
                        <label for="randomText" class="form-label text-nowrap fw-bold">Product Specifications</label>
                        
                        <div class="container m-0 p-0">
                            <div class="row">
                                @if (ReviewThenModifyProduct.CompileProductProperties.ProductSpecs.Count == 0)
                                {
                                    <div class="position-absolute top-50 start-50 translate-middle">
                                        <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var specs in ReviewThenModifyProduct.CompileProductProperties.ProductSpecs)
                                    {
                                        if (specs.KeyName!.Contains("Warranty Type", StringComparison.CurrentCultureIgnoreCase))
                                        {
                                            <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                                <label for="randomText" class="form-label text-nowrap fw-bold">@($"{specs.KeyName}")</label>
                                                <Dropdown Color="DropdownColor.Light" Size="DropdownSize.Small" Class="w-100">
                                                    <DropdownToggleButton>@(ReviewThenModifyProduct.SelectedWarrantyType ?? "Select a warranty type")
                                                    </DropdownToggleButton>
                                                    <DropdownMenu Class="w-100">
                                                        @foreach (var warrantyType in ReviewThenModifyProduct.CompileProductProperties.ProductWarrantyType)
                                                        {
                                                            <DropdownItem @onclick="() => OnWarrantyTypeItemSelected(warrantyType)" Active="@warrantyType.State"
                                                                Disabled="@(warrantyType.ID == 2)" Class="w-100">
                                                                @warrantyType.Item
                                                            </DropdownItem>
                                                        }
                                                    </DropdownMenu>
                                                </Dropdown>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                                <label for="randomText" class="form-label text-nowrap fw-bold">@($"{specs.KeyName}")</label>
                                                <InputText id="@($"{specs.KeyNameID}")"
                                                    @bind-Value="specs.Value"
                                                    class="form-control form-control-sm" />
                                                <ValidationMessage id="@($"{specs.KeyNameID}")"
                                                    For="() => specs.Value"
                                                    class="text-danger" />
                                            </div>
                                        }
                                    }
                                }
                                <div class="col-12 col-sm-6 col-lg-3 mb-3 d-flex flex-column align-items-start">
                                    <label for="randomText" class="form-label text-nowrap fw-bold">Sort list</label>
                                    <SortableList TItem="ProductSpecsFRSort" Data="productSpecs" Context="item" OnUpdate="@OnProdSpecsListUpdate">
                                        <ItemTemplate>
                                            @item.Value
                                        </ItemTemplate>
                                    </SortableList>
                                </div>
                            </div>
                        </div>
                    </div>
                    

                    <div class="mb-3 d-flex flex-column align-items-start w-100">
                        <label for="randomText" class="form-label text-nowrap fw-bold">Product Description</label>
                        <div class="w-100">
                            <div id="editor" class="w-100 rounded-bottom"></div> @*Could be replaced with https://demos.blazorbootstrap.com/markdown if the images were accessible through a link.*@
                        </div>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

<div id="liveToastError"
  class="toast align-items-center text-bg-danger border-0 position-fixed bottom-0 end-0 mb-3 me-3" role="alert"
  aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
  <div class="d-flex">
    @if (errorMessage is not null)
    {
      <div class="toast-body">
        Someting went wrong: "@errorMessage". Please try again later.
      </div>
    }
    else
    {
      <div class="toast-body">
        Someting went wrong. Please try again later.
      </div>
    }
    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"
      aria-label="Close"></button>
  </div>
</div>

@code {
    private void ButtonClicked() => NavigationManager.NavigateTo("simulate/images");
    private EditContext? editContext;
    private ValidationMessageStore? messageStore;
    private ReviewThenModifyProduct ReviewThenModifyProduct = new ReviewThenModifyProduct();
    private BlazorSQLServerContext context = default!;
    private Guid Id => Guid.NewGuid();
    protected string? Value { get; set; }
    protected bool IsContainSpecialCharacter { get; set; }
    
    [Parameter]
    public string? prodId { get; set; }
    public record ProductSpecsFRSort(string? KeyNameID, string? KeyName, string? Value, int Rank);
    public record ProductTagsRefFRAutoComplete(string Tag);
    public List<ProductSpecsFRSort> productSpecs = new();
    public List<ProductTagsRefFRAutoComplete> productTagRef = new();
    private string? errorMessage;
    InputFile filePicker = new();
    
    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(ReviewThenModifyProduct);
        messageStore = new ValidationMessageStore(editContext);

        editContext.OnValidationRequested += HandleValidationRequested;
        context = DbFactory.CreateDbContext();
        ReviewThenModifyProduct.SelectedCategory = "Jewelry";
        SetActiveCategory(1);
        await RetrieveProductMainForReview();
        await RetrievePromoTagForReview();
        await RetrievePromoTagRefForReview();
        await RetrieveProductImagesForReview();
        await RetrieveProductSpecsForReview();
        await RetrieveProducDescriptionForReview();
    }

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs e)
    {
        messageStore!.Clear();

        @* if (isModifyUser)
        {
            if (string.IsNullOrWhiteSpace(VerifyRemRoleUser.SelectedRole))
            {
                messageStore.Add(() => VerifyRemRoleUser.SelectedRole!, "Required field.");
            }
        }
        else if (isReevaluateUser)
        {
            // Only validate VerifyRemRoleUser.SelectedRemark if VerifyRemRoleUser.SelectedRole is valid
            if (string.IsNullOrWhiteSpace(VerifyRemRoleUser.SelectedRemark))
            {
                messageStore.Add(() => VerifyRemRoleUser.SelectedRemark!, "Required field.");
            }
        }
        else
        {
            messageStore.Add(() => VerifyRemRoleUser.SelectedRole!, "Required field.");
            messageStore.Add(() => VerifyRemRoleUser.SelectedRemark!, "Required field.");
        } *@
    }

    private async Task RetrieveProductMainForReview()
    {
        var sQLServerHelper = new SQLServerHelper(context);
        ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview = null;
        StateHasChanged();
        var spParam = SQLServerInnerHelper.ManageAdminProductsWOutputPageParams(prodID: prodId, functionKey: "REVIEW_PRODUCT");
        ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview = await
        sQLServerHelper.ProductMainFRFromSqlAsync("rpiAPSM_spManageProductsWOutput", spParam);
        if (ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        ReviewThenModifyProduct.ProdNameEntry = ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview?.ProdName;
        ReviewThenModifyProduct.ProdNameLC = ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview?.ProdName?.Length ?? 0;
        ReviewThenModifyProduct.ProdStock = ReviewThenModifyProduct.CompileProductProperties.ProductMainForReview?.Stock ?? 0;
        StateHasChanged();
    }

    private async Task RetrievePromoTagForReview()
    {
        var sQLServerHelper = new SQLServerHelper(context);
        ReviewThenModifyProduct.CompileProductProperties.Tags = [];
        StateHasChanged();
        var spParam = SQLServerInnerHelper.ManageAdminProductsWOutputPageParams(prodID: prodId, functionKey:
        "REVIEW_PRODUCT_PROMO_TAG");
        ReviewThenModifyProduct.CompileProductProperties.Tags = await
        sQLServerHelper.ProductPromoTagFRFromSqlAsyncList("rpiAPSM_spManageProductsWOutput", spParam);
        if (ReviewThenModifyProduct.CompileProductProperties.Tags is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        StateHasChanged();
    }

    private async Task RetrievePromoTagRefForReview()
    {
        var sQLServerHelper = new SQLServerHelper(context);
        ReviewThenModifyProduct.CompileProductProperties.TagRefList = [];
        StateHasChanged();
        var spParam = SQLServerInnerHelper.ManageAdminProductsWOutputPageParams(prodID: prodId, functionKey:
        "RETRIEVE_PROMO_TAG_REF");
        ReviewThenModifyProduct.CompileProductProperties.TagRefList = await
        sQLServerHelper.ProductPromoTagRefFRFromSqlAsyncList("rpiAPSM_spManageProductsWOutput", spParam);
        if (ReviewThenModifyProduct.CompileProductProperties.Tags is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        ReviewThenModifyProduct.CompileProductProperties.TagRefList.Add(
            new ProductPromoTagRefFR
            {
                Tag = "Simulate tag item 1"
            }
        );
        ReviewThenModifyProduct.CompileProductProperties.TagRefList.Add(
            new ProductPromoTagRefFR
            {
                Tag = "Simulate tag item 2"
            }
        );
        StateHasChanged();
    }

    private async Task<AutoCompleteDataProviderResult<ProductTagsRefFRAutoComplete>> ProductTagRefDataProvider(AutoCompleteDataProviderRequest<ProductTagsRefFRAutoComplete> request)
    {
        var query = ReviewThenModifyProduct.CompileProductProperties.TagRefList.AsQueryable();

        // Apply filtering if user typed something
        if (!string.IsNullOrWhiteSpace(request.Filter?.Value))
        {
            query = query.Where(data =>
                data.Tag.Contains(request.Filter.Value, StringComparison.OrdinalIgnoreCase));
        }

        var productTagRef = query
            .Select(data => new ProductTagsRefFRAutoComplete(data.Tag))
            .ToList();

        return await Task.FromResult(new AutoCompleteDataProviderResult<ProductTagsRefFRAutoComplete>
        {
            Data = productTagRef,
            TotalCount = productTagRef.Count
        });
    }

    private void OnAutoCompleteChanged(ProductTagsRefFRAutoComplete tagRef)
    {
        @* Console.WriteLine($"'{tagRef?.Tag}' selected."); *@
        
        IsContainSpecialCharacter = false;
        var fieldTagRef = editContext!.Field(nameof(ReviewThenModifyProduct.TagRef));
        messageStore?.Clear(fieldTagRef);

        if (!String.IsNullOrEmpty(tagRef?.Tag))
        {        
            var fieldTag = editContext!.Field(nameof(ReviewThenModifyProduct.CompileProductProperties.Tags));
            if (ReviewThenModifyProduct.CompileProductProperties.Tags.Count < 5)
            {
                if (!ReviewThenModifyProduct.CompileProductProperties.Tags.Exists(t => t.TagValues!.Equals(tagRef?.Tag, StringComparison.CurrentCultureIgnoreCase)))
                {
                    string pTagID = Guid.NewGuid().ToString().Replace("-", "").ToUpper();
                    int getLength = pTagID.Count();
                    string reprocessedStringID = "";
                    string dateNow = DateTime.Now.ToString("yyyy-MM-dd");
                    for (int i = 0; i <= getLength; i++)
                    {
                        if (i < 13)
                        {
                            reprocessedStringID = pTagID.Substring(0, i);
                            if (i == 12)
                            {
                                break;
                            }
                        }
                    }
                    string concatString = String.Concat("PROD_PT-", dateNow, "-", reprocessedStringID);
                    ReviewThenModifyProduct.CompileProductProperties.Tags.Add(
                        new ProductPromoTagFR
                        {
                            PromoID = concatString,
                            TagValues = tagRef?.Tag.ToString()!,
                        }
                    );
                    ReviewThenModifyProduct.TagRef = string.Empty;
                    messageStore?.Clear(fieldTag);
                }
                else
                {
                    ReviewThenModifyProduct.TagRef = string.Empty;
                }
            }
            else
            {
                messageStore!.Add(() => ReviewThenModifyProduct.TagRef!, "You can add promo tag of up to 5 items only.");
            }

        }
        else
        {
            messageStore!.Add(() => ReviewThenModifyProduct.TagRef!, "Cannot be empty text.");
        }
    }

    private async Task RetrieveProductImagesForReview()
    {
        var sQLServerHelper = new SQLServerHelper(context);
        ReviewThenModifyProduct.CompileProductProperties.ProductImages = [];
        StateHasChanged();
        var spParam = SQLServerInnerHelper.ManageAdminProductsWOutputPageParams(prodID: prodId, functionKey:
        "REVIEW_PRODUCT_IMAGES");
        ReviewThenModifyProduct.CompileProductProperties.ProductImages = await
        sQLServerHelper.ProductImagesFRFromSqlAsyncList("rpiAPSM_spManageProductsWOutput", spParam);
        if (ReviewThenModifyProduct.CompileProductProperties.ProductImages is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        StateHasChanged();
    }

    private async Task RetrieveProductSpecsForReview()
    {
        var sQLServerHelper = new SQLServerHelper(context);
        ReviewThenModifyProduct.CompileProductProperties.ProductSpecs = [];
        StateHasChanged();
        var spParam = SQLServerInnerHelper.ManageAdminProductsWOutputPageParams(prodID: prodId, functionKey:
        "REVIEW_PRODUCT_SPECS");
        ReviewThenModifyProduct.CompileProductProperties.ProductSpecs = await
        sQLServerHelper.ProductSpecsFRFromSqlAsyncList("rpiAPSM_spManageProductsWOutput", spParam);
        if (ReviewThenModifyProduct.CompileProductProperties.ProductSpecs is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        foreach(var data in ReviewThenModifyProduct.CompileProductProperties.ProductSpecs!)
        {
            productSpecs.Add(new ProductSpecsFRSort(data.KeyNameID, data.KeyName, data.Value, data.Rank));
        }
        ReviewThenModifyProduct.SelectedWarrantyType = ReviewThenModifyProduct.CompileProductProperties.ProductSpecs?.FirstOrDefault(d => d.KeyName!.Contains("Warranty Type", StringComparison.OrdinalIgnoreCase))?.Value;
        ReviewThenModifyProduct.SelectedWarrantyTypeID = (int)ReviewThenModifyProduct.CompileProductProperties.ProductWarrantyType?.FirstOrDefault(d => d.Item!.Contains(ReviewThenModifyProduct.SelectedWarrantyType!, StringComparison.OrdinalIgnoreCase))?.ID!;
        SetActiveWarrantyType((int)ReviewThenModifyProduct.SelectedWarrantyTypeID);
        StateHasChanged();
    }

    private async Task RetrieveProducDescriptionForReview()
    {
        var sQLServerHelper = new SQLServerHelper(context);
        ReviewThenModifyProduct.CompileProductProperties.ProductDescription = null;
        StateHasChanged();
        var spParam = SQLServerInnerHelper.ManageAdminProductsWOutputPageParams(prodID: prodId, functionKey:
        "REVIEW_PROD_DESCRIPTION");
        ReviewThenModifyProduct.CompileProductProperties.ProductDescription = await
        sQLServerHelper.ProductDescriptionFRFromSqlAsync("rpiAPSM_spManageProductsWOutput", spParam);
        if (ReviewThenModifyProduct.CompileProductProperties.ProductImages is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        await JS.InvokeVoidAsync("setContent", ReviewThenModifyProduct.CompileProductProperties.ProductDescription?.Description);
        StateHasChanged();
    }

