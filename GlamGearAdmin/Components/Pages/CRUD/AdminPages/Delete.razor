@page "/admins/delete"
@using Microsoft.EntityFrameworkCore
@using GlamGearAdmin.Models
@inject IDbContextFactory<GlamGearAdmin.Data.BlazorWebAppAdminContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Admin</h2>
    <hr />
    @if (admin is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Username</dt>
            <dd class="col-sm-10">@admin.Username</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Given Name</dt>
            <dd class="col-sm-10">@admin.GivenName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Middle Name</dt>
            <dd class="col-sm-10">@admin.MiddleName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Family Name</dt>
            <dd class="col-sm-10">@admin.FamilyName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Email Add</dt>
            <dd class="col-sm-10">@admin.EmailAdd</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Role Type</dt>
            <dd class="col-sm-10">@admin.RoleType</dd>
        </dl>
        <EditForm method="post" Model="admin" OnValidSubmit="DeleteAdmin" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(admin is null)">Delete</button> |
            <a href="/admins">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Admin? admin;

    [SupplyParameterFromQuery]
    private string? UserID { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        admin = await context.Admin.FirstOrDefaultAsync(m => m.UserID == UserID);

        if (admin is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteAdmin()
    {
        using var context = DbFactory.CreateDbContext();
        context.Admin.Remove(admin!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/admins");
    }
}
