@page "/users/review-user"
@using Microsoft.EntityFrameworkCore
@using GlamGearAdmin.Models.SQLServer
@using GlamGearAdmin.Data.SQLServer
@implements IAsyncDisposable
@inject IDbContextFactory<GlamGearAdmin.Data.SQLServer.BlazorSQLServerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h3>Review User</h3>

<div>
  <hr />
  @if (reviewUserListSingle is null)
  {
    <div class="position-absolute top-50 start-50 translate-middle">
      <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
    </div>
  }
  else
  {
    <dl class="row">
      <dt class="col-sm-2">Role</dt>
      <dd class="col-sm-10">@reviewUserListSingle.RoleType</dd>
      <dt class="col-sm-2">Display Name</dt>
      <dd class="col-sm-10">@reviewUserListSingle.DispName</dd>
      <dt class="col-sm-2">Remarks</dt>
      @if (reviewUserListSingle.Remarks == null)
      {
        <dd class="col-sm-10 fw-bold">-</dd>
      }
      else
      {
        <dd class="col-sm-10">@reviewUserListSingle.Remarks</dd>
      }
      <dt class="col-sm-2">Date Registered</dt>
      <dd class="col-sm-10">@reviewUserListSingle.DtRegistered</dd>
      <dt class="col-sm-2">Front ID</dt>
      <dd class="col-sm-10">
        @if (frontID is not null)
        {
          <img src="@frontID" class="img-thumbnail my-3" alt="Front ID" />
        }
        else
        {
          <span class="text-muted fw-bold">-</span>
        }
      </dd>
      <dt class="col-sm-2">Back ID</dt>
      <dd class="col-sm-10">
        @if (backID is not null)
        {
          <img src="@backID" class="img-thumbnail my-3" alt="Front ID" />
        }
        else
        {
          <span class="text-muted fw-bold">-</span>
        }
      </dd>
      <dt class="col-sm-2">Selfie</dt>
      <dd class="col-sm-10">
        @if (selfie is not null)
        {
          <img src="@selfie" class="img-thumbnail my-3" alt="Front ID" />
        }
        else
        {
          <span class="text-muted fw-bold">-</span>
        }
      </dd>
    </dl>
    <div class="my-3">
      <a href="@($"/users/user-list")">Back to List</a>
    </div>
  }
</div>

@code {
  private UserListSingleDM? reviewUserListSingle = new();
  private BlazorSQLServerContext context = default!;

  [SupplyParameterFromQuery(Name = "userid")]
  private string? id { get; set; }

  string? frontID;
  string? backID;
  string? selfie;

  protected override async Task OnInitializedAsync()
  {
    context = DbFactory.CreateDbContext();
    var sQLServerHelper = new SQLServerHelper(context);
    var spParam = SQLServerInnerHelper.ManageUsersDataWOutputPageParams(userID: id, functionKey:
    "SIMULATE_REVIEW_USER");
    reviewUserListSingle = await sQLServerHelper.UserListFromSqlAsync("rpiAPSM_spManageUsersDataWOutput", spParam);

    if (reviewUserListSingle is null)
    {
      NavigationManager.NavigateTo("notfound");
    }
    frontID = dbDataToImg(reviewUserListSingle?.FrontID);
    backID = dbDataToImg(reviewUserListSingle?.BackID);
    selfie = dbDataToImg(reviewUserListSingle?.Selfie);
  }

  private string? dbDataToImg(byte[]? imgBytes)
  {
    if (imgBytes is null || imgBytes.Length == 0)
    {
      return null;
    }
    else
    {
      return $"data:image/png;base64,{Convert.ToBase64String(imgBytes)}";
    }

  }

  public async ValueTask DisposeAsync() // this is important
  {
    await context.DisposeAsync();
  }
}
