@page "/sqlite/crud/admin_pages"
@rendermode InteractiveServer
@using GlamGearAdmin.Data.SQLite
@using GlamGearAdmin.Models.SQLite
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using GlamGearAdmin.Models
@using GlamGearAdmin.Data
@implements IAsyncDisposable
@inject IDbContextFactory<GlamGearAdmin.Data.SQLite.BlazorWebAppAdminContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="sqlite/crud/admin_pages/create">Create New</a>
</p>

<input type="search" @bind="givenNameFilter" @bind:event="oninput" />

<div>

    <QuickGrid Class="table" Items="FilteredAdmin" Pagination="pagination">
        <PropertyColumn Property="admin => admin.Username" Sortable="true" />
        <PropertyColumn Property="admin => admin.GivenName" Sortable="true" />
        <PropertyColumn Property="admin => admin.MiddleName" Sortable="true" />
        <PropertyColumn Property="admin => admin.FamilyName" Sortable="true" />
        <PropertyColumn Property="admin => admin.EmailAdd" Sortable="true" />
        <PropertyColumn Property="admin => admin.RoleType" Sortable="true" />

        <TemplateColumn Context="admin">
            <a href="@($"sqlite/crud/admin_pages/edit?userid={admin.UserID}")">Edit</a> |
            <a href="@($"sqlite/crud/admin_pages/details?userid={admin.UserID}")">Details</a> |
            <a href="@($"sqlite/crud/admin_pages/delete?userid={admin.UserID}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
</div>
<Paginator State="pagination" />

@code {
    private BlazorWebAppAdminContext context = default!;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };
    private string givenNameFilter = string.Empty;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    private IQueryable<Admin> FilteredAdmin =>
    context.Admin.Where(m => m.GivenName!.ToLower().Contains(givenNameFilter.ToLower()));
}
