@page "/sqlite/crud/admin_pages/edit"
@using GlamGearAdmin.Models.SQLite
@using Microsoft.EntityFrameworkCore
@using GlamGearAdmin.Models
@inject IDbContextFactory<GlamGearAdmin.Data.SQLite.BlazorWebAppAdminContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Admin</h2>
<hr />
@if (adminData is null)
{
    <div class="position-absolute top-50 start-50 translate-middle">
        <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="adminData" OnValidSubmit="UpdateAdmin" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="adminData.UserID" value="@adminData.UserID" />
                <div class="mb-3">
                    <label for="username" class="form-label">Username:</label>
                    <InputText id="username" @bind-Value="adminData.Username" class="form-control" />
                    <ValidationMessage For="() => adminData.Username" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="givenName" class="form-label">Given Name:</label>
                    <InputText id="givenName" @bind-Value="adminData.GivenName" class="form-control" />
                    <ValidationMessage For="() => adminData.GivenName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="middleName" class="form-label">Middle Name:</label>
                    <InputText id="middleName" @bind-Value="adminData.MiddleName" class="form-control" />
                    <ValidationMessage For="() => adminData.MiddleName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="familyName" class="form-label">Family Name:</label>
                    <InputText id="familyName" @bind-Value="adminData.FamilyName" class="form-control" />
                    <ValidationMessage For="() => adminData.FamilyName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="emailadd" class="form-label">Email Add:</label>
                    <InputText id="emailadd" @bind-Value="adminData.EmailAdd" class="form-control" />
                    <ValidationMessage For="() => adminData.EmailAdd" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="roletype" class="form-label">Role Type:</label>
                    <InputText id="roletype" @bind-Value="adminData.RoleType" class="form-control" />
                    <ValidationMessage For="() => adminData.RoleType" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/sqlite/crud/admin_pages">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? userID { get; set; }

    [SupplyParameterFromForm]
    private Admin? adminData { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        adminData ??= await context.Admin.FirstOrDefaultAsync(m => m.UserID == userID);

        if (adminData is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateAdmin()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(adminData!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {

            if (!AdminExists(adminData!.UserID))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/sqlite/crud/admin_pages");
    }

    private bool AdminExists(string? userid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Admin.Any(e => e.UserID == userid);
    }
}
