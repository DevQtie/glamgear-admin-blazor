@page "/dashboard"
@using GlamGearAdmin.Components.Charts
@using GlamGearAdmin.Data
@using GlamGearAdmin.Models.SQLite
@using Microsoft.EntityFrameworkCore
@using GlamGearAdmin.Models
@using System.Globalization
@rendermode InteractiveServer
@inject IDbContextFactory<GlamGearAdmin.Data.SQLite.BlazorWebAppAdminContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Dashboard</PageTitle>

@if (admin is null)
{
  <h2 class="fw-bold">Welcome back, Anonymous!</h2>
}
else
{
  @if (username == null)
  {
    <h2 class="fw-bold">Welcome back, @fullName!</h2>
  }
  else if (username != null)
  {
    <h2 class="fw-bold">Welcome back, @username!</h2>
  }
  else
  {
    <h2 class="fw-bold">Welcome back, Anonymous!</h2>
  }
}

<div class="my-3"></div>

@*<button class="btn btn-primary my-3" @onclick="ButtonClicked">Simulate Test Data</button> To test SQLite CRUD*@

<div class="container m-0 p-0">
  <div class="row">
    <div class="col-12 col-sm-6 col-lg-3 mb-3">
      <button type="button" class="btn w-100 border-0 bg-transparent p-0 text-start">
        <div class="p-3 border rounded border-secondary-subtle text-center">
          <div class="border rounded-4 bg-body d-inline-block py-2 px-2">
            <span class="bi bi-boxes-icon align-middle dashboard-icon-style" aria-hidden="true"></span>
            <span>@Math.Round(displayValueTProducts).ToString("N0", CultureInfo.GetCultureInfo("en-US"))</span>
          </div>
          <div class="text-secondary-emphasis mt-1">
            <span>Total Products</span>
          </div>
        </div>
      </button>
    </div>
    <div class="col-12 col-sm-6 col-lg-3 mb-3">
      <button type="button" class="btn w-100 border-0 bg-transparent p-0 text-start">
        <div class="p-3 border rounded border-secondary-subtle text-center">
          <div class="border rounded-4 bg-body d-inline-block py-2 px-2">
            <span class="bi bi-ui-checks-icon align-middle dashboard-icon-style" aria-hidden="true"></span>
            <span>@Math.Round(displayValueTOrders).ToString("N0", CultureInfo.GetCultureInfo("en-US"))</span>
          </div>
          <div class="text-secondary-emphasis mt-1">
            Total Orders
          </div>
        </div>
      </button>
    </div>
    <div class="col-12 col-sm-6 col-lg-3 mb-3">
      <button type="button" class="btn w-100 border-0 bg-transparent p-0 text-start">
        <div class="p-3 border rounded border-secondary-subtle text-center">
          <div class="border rounded-4 bg-body d-inline-block py-2 px-2">
            <span class="bi bi-people-fill-icon align-middle dashboard-icon-style" aria-hidden="true"></span>
            <span>@Math.Round(displayValueTUsers).ToString("N0", CultureInfo.GetCultureInfo("en-US"))</span>
          </div>
          <div class="text-secondary-emphasis mt-1">
            Total Users
          </div>
        </div>
      </button>
    </div>
    <div class="col-12 col-sm-6 col-lg-3 mb-3">
      <button type="button" class="btn w-100 border-0 bg-transparent p-0 text-start">
        <div class="p-3 border rounded border-secondary-subtle text-center">
          <div class="border rounded-4 bg-body d-inline-block py-2 px-2">
            <span class="bi bi-receipt-icon align-middle dashboard-icon-style" aria-hidden="true"></span>
            <span>@Math.Round(displayValueTSales).ToString("N0", CultureInfo.GetCultureInfo("en-US"))</span>
          </div>
          <div class="text-secondary-emphasis mt-1">
            Total Sales
          </div>
        </div>
      </button>
    </div>
  </div>
</div>

<hr>
<div class="container-fluid">
  <div class="row">
    <div class="col-12 col-lg-6 mb-3">
      <BarChartComp />
    </div>
    <div class="col-12 col-lg-6 mb-3">
      <LineChartComp />
    </div>
    <div class="col-12 col-lg-6 mb-3">
      <ScatterChartComp />
    </div>
  </div>
</div>

<hr>

<div class="container-fluid">
  <div class="row">
    <div class="col-12 col-lg-6 mb-3">
      <PieChartComp />
    </div>
    <div class="col-12 col-lg-6 mb-3">
      <DoughnutChartComp />
    </div>
  </div>
</div>

@code {
  private Admin? admin;
  private string? fullName;
  private string? username;
  private void ButtonClicked() => NavigationManager.NavigateTo("sqlite/crud/admin_pages"); //sql_server sqlite
  [Parameter] public double TargetValueTProducts { get; set; } = 1000;
  [Parameter] public double TargetValueTOrders { get; set; } = 11000;
  [Parameter] public double TargetValueTUsers { get; set; } = 1234567;
  [Parameter] public double TargetValueTSales { get; set; } = 2345678;
  [Parameter] public int DurationMs { get; set; } = 250;
  [Parameter] public int FrameRate { get; set; } = 120;

  private double displayValueTProducts = 0;
  private double displayValueTOrders = 0;
  private double displayValueTUsers = 0;
  private double displayValueTSales = 0;
  private double incrementTProducts;
  private double incrementTOrders;
  private double incrementTUsers;
  private double incrementTSales;
  private int totalFrames;
  private int currentFrame = 0;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      totalFrames = DurationMs / (1000 / FrameRate);
      incrementTProducts = TargetValueTProducts / totalFrames;
      incrementTOrders = TargetValueTOrders / totalFrames;
      incrementTUsers = TargetValueTUsers / totalFrames;
      incrementTSales = TargetValueTSales / totalFrames;

      while (currentFrame < totalFrames)
      {
        displayValueTProducts += incrementTProducts;
        displayValueTOrders += incrementTOrders;
        displayValueTUsers += incrementTUsers;
        displayValueTSales += incrementTSales;
        currentFrame++;
        StateHasChanged();
        await Task.Delay(1000 / FrameRate);
      }

      displayValueTProducts = TargetValueTProducts; // snap to final value
      displayValueTOrders = TargetValueTOrders; // snap to final value
      displayValueTUsers = TargetValueTUsers; // snap to final value
      displayValueTSales = TargetValueTSales; // snap to final value
      StateHasChanged();
    }
  }

  protected override async Task OnInitializedAsync()
  {
    using var context = DbFactory.CreateDbContext();
    admin = await context.Admin.FirstOrDefaultAsync(m => m.RoleType == "Developer");

    if (admin is not null)
    {
      fullName = String.Concat(admin.GivenName, " ", admin.MiddleName == null ? "" : admin.MiddleName, admin.MiddleName ==
      null ? "" : " ", admin.FamilyName);
      username = admin.Username?.ToString();
    }
  }
}