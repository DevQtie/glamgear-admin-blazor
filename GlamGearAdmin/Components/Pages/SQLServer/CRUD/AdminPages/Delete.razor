@page "/sql_server/crud/admin_pages/delete"
@rendermode InteractiveServer
@using GlamGearAdmin.Data.SQLServer
@using Microsoft.EntityFrameworkCore
@using GlamGearAdmin.Models.SQLServer
@implements IAsyncDisposable
@inject IDbContextFactory<GlamGearAdmin.Data.SQLServer.BlazorSQLServerContext> DbFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS


<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Admin</h2>
    <hr />
    @if (admin is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">ID</dt>
            <dd class="col-sm-10">@admin.Id</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Random Text</dt>
            <dd class="col-sm-10">@admin.RandomText</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">MiddleName</dt>
            <dd class="col-sm-10">@admin.DtStamp</dd>
        </dl>
        <EditForm method="post" Model="admin" OnValidSubmit="DeleteAdmin" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(admin is null)">Delete</button> |
            <a href="/sql_server/crud/admin_pages">Back to List</a>
        </EditForm>
    }
</div>

@* To use Bootstrap Toasts, visit this website: https://getbootstrap.com/docs/5.3/components/toasts/ *@

@* <button class="btn btn-primary mt-3" @onclick="ShowToast">Show Toast</button> *@

@* <div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto">Info</strong>
