@page "/sql_server/crud/admin_pages/details"
@using Microsoft.EntityFrameworkCore
@using GlamGearAdmin.Models.SQLServer
@using GlamGearAdmin.Data.SQLServer
@implements IAsyncDisposable
@inject IDbContextFactory<GlamGearAdmin.Data.SQLServer.BlazorSQLServerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Admin</h2>
    <hr />
    @if (admin is null)
    {
        <div class="position-absolute top-50 start-50 translate-middle">
            <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Username</dt>
            <dd class="col-sm-10">@admin.Id</dd>
            <dt class="col-sm-2">GivenName</dt>
            <dd class="col-sm-10">@admin.RandomText</dd>
            <dt class="col-sm-2">MiddleName</dt>
            <dd class="col-sm-10">@admin.DtStamp</dd>
        </dl>
        <div>
            <a href="@($"/sql_server/crud/admin_pages/edit?userid={admin.Id}")">Edit</a> |
            <a href="@($"/sql_server/crud/admin_pages")">Back to List</a>
        </div>
    }
</div>

@code {
    private RandText? admin = new();
    private BlazorSQLServerContext context = default!;

    [SupplyParameterFromQuery(Name = "userid")]
    private int id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        var sQLServerHelper = new SQLServerHelper(context);
        admin = await sQLServerHelper.GetRandTextsFromSqlAsync("rpiAPSM_spRandomTextWParam", id, null,
        "SEE_DET", null);

        if (admin is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    public async ValueTask DisposeAsync() // this is important
    {
        await context.DisposeAsync();
    }
}
