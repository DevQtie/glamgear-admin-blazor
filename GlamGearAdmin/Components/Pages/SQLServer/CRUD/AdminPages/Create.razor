<div id="liveToast" class="toast align-items-center text-bg-primary border-0 position-fixed bottom-0 end-0 mb-3 me-3"
    role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="1500">
    <div class="d-flex">
        <div class="toast-body">
            New records created successfully!
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"
            @onclick="DisposeToastThenNavigate"></button>
    </div>
</div>

<div id="liveToastError"
    class="toast align-items-center text-bg-danger border-0 position-fixed bottom-0 end-0 mb-3 me-3" role="alert"
    aria-live="assertive" aria-atomic="true" data-bs-delay="1500">
    <div class="d-flex">
        <div class="toast-body">
            Someting went wrong. Please try again later.
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"
            aria-label="Close"></button>
    </div>
</div>

<script>
    window.showLiveToast = () => {
        const toastEl = document.getElementById('liveToast');
        if (toastEl) {
            const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
            toast.show();

            toastEl.addEventListener('hidden.bs.toast', () => {
                window.location.replace('/sql_server/crud/admin_pages');
            });
        }
    };
    window.showLiveToastError = () => {
        const toastEl = document.getElementById('liveToastError');
        if (toastEl) {
            const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
            toast.show();
        }
    };
</script>

@code {
    [SupplyParameterFromForm]
    private RandText Admin { get; set; } = new();
    private string? output;
    private BlazorSQLServerContext context = default!;
    private EditContext? editContext;

    protected override void OnInitialized()
    {
        editContext = new EditContext(Admin);
        context = DbFactory.CreateDbContext();
        editContext.OnFieldChanged += HandleFieldChanged;
    }

    @* To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks. *@
    private async Task AddAdmin()
    {
        context = DbFactory.CreateDbContext();
        var sQLServerHelper = new SQLServerHelper(context);
        output = await sQLServerHelper.CreDelUpdStringOutputAsync("rpiAPSM_spRandomTextWParam", null, Admin?.RandomText,
        "ADD_NEW_REC");
        if (output is null)
        {
            await JS.InvokeVoidAsync("showLiveToastError");
        }
        else
        {
            await JS.InvokeVoidAsync("showLiveToast");
        }
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        // Automatically validate the field as it changes
        editContext?.Validate();
    }

    private void OnInputChanged(ChangeEventArgs e)
    {
        Admin.RandomText = e.Value?.ToString();
        editContext?.NotifyFieldChanged(FieldIdentifier.Create(() => Admin.RandomText));
    }

    private void DisposeToastThenNavigate()
    {
        NavigationManager.NavigateTo("/sql_server/crud/admin_pages", replace: true);
    }

    public async ValueTask DisposeAsync() // this is important
    {
        await context.DisposeAsync();
    }
}
