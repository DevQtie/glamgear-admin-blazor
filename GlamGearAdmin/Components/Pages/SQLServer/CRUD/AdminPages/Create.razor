@page "/sql_server/crud/admin_pages/create"
@rendermode InteractiveServer
@using GlamGearAdmin.Data.SQLServer
@using Microsoft.EntityFrameworkCore
@using GlamGearAdmin.Models.SQLServer
@implements IAsyncDisposable
@inject IDbContextFactory<GlamGearAdmin.Data.SQLServer.BlazorSQLServerContext> DbFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Admin</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" EditContext="editContext" OnValidSubmit="AddAdmin" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <label for="randomText" class="form-label">Random Text:</label>
                <InputText id="randomText" @bind-Value="Admin.RandomText" class="form-control"
                    @oninput="OnInputChanged" />
                <ValidationMessage For="() => Admin.RandomText" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/sql_server/crud/admin_pages">Back to List</a>
</div>

@* To use Bootstrap Toasts, visit this website: https://getbootstrap.com/docs/5.3/components/toasts/ *@

@* <button class="btn btn-primary mt-3" @onclick="ShowToast">Show Toast</button> *@

