@page "/sql_server/crud/admin_pages/edit"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using GlamGearAdmin.Models.SQLServer
@using GlamGearAdmin.Data.SQLServer
@implements IAsyncDisposable
@inject IDbContextFactory<GlamGearAdmin.Data.SQLServer.BlazorSQLServerContext> DbFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Admin</h2>
<hr />
@if (Admin is null)
{
    <div class="position-absolute top-50 start-50 translate-middle">
        <div class="spinner-grow text-danger spinner-grow-xxl" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Admin" OnValidSubmit="UpdateAdmin" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <input type="hidden" name="Admin.Id" value="@Admin.Id" />
                <div class="mb-3">
                    <label for="randomText" class="form-label">Random Text:</label>
                    <InputText id="randomText" @bind-Value="Admin.RandomText" class="form-control" />
                    <ValidationMessage For="() => Admin.RandomText" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/sql_server/crud/admin_pages">Back to List</a>
</div>

