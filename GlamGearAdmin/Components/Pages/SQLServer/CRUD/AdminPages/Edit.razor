@page "/sql_server/crud/admin_pages/edit"
@using Microsoft.EntityFrameworkCore
@using GlamGearAdmin.Models.SQLServer
@inject IDbContextFactory<GlamGearAdmin.Data.SQLServer.BlazorSQLServerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Admin</h2>
<hr />
@if (Admin is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Admin" OnValidSubmit="UpdateAdmin" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Admin.Id" value="@Admin.Id" />
                <div class="mb-3">
                    <label for="randomText" class="form-label">Random Text:</label>
                    <InputText id="randomText" @bind-Value="Admin.RandomText" class="form-control" />
                    <ValidationMessage For="() => Admin.RandomText" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/sql_server/crud/admin_pages">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int id { get; set; }

    [SupplyParameterFromForm]
    private RandText? Admin { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Admin ??= await context.RandText.FirstOrDefaultAsync(m => m.Id == id);

        if (Admin is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateAdmin()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Admin!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!AdminExists(Admin!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/sql_server/crud/admin_pages");
    }

    private bool AdminExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.RandText.Any(e => e.Id == id);
    }
}
