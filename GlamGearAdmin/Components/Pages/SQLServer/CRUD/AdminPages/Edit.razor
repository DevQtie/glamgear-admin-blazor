@page "/sql_server/crud/admin_pages/edit"
@using Microsoft.EntityFrameworkCore
@using GlamGearAdmin.Models.SQLServer
@using GlamGearAdmin.Data.SQLServer
@implements IAsyncDisposable
@inject IDbContextFactory<GlamGearAdmin.Data.SQLServer.BlazorSQLServerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Admin</h2>
<hr />
@if (admin is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="admin" OnValidSubmit="UpdateAdmin" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="admin.Id" value="@admin.Id" />
                <div class="mb-3">
                    <label for="randomText" class="form-label">Random Text:</label>
                    <InputText id="randomText" @bind-Value="admin.RandomText" class="form-control" />
                    <ValidationMessage For="() => admin.RandomText" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/sql_server/crud/admin_pages">Back to List</a>
</div>

@code {
    private RandText? admin = new();
    private BlazorSQLServerContext context = default!;

    [SupplyParameterFromQuery(Name = "userid")]
    private int id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        var sQLServerHelper = new SQLServerHelper(context);
        admin ??= await sQLServerHelper.GetRandTextsFromSqlAsync("rpiAPSM_spRandomTextWParam", id, null,
        "SEE_DETAILS");

        if (admin is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateAdmin()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(admin!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!AdminExists(admin!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/sql_server/crud/admin_pages");
    }

    private bool AdminExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.RandText.Any(e => e.Id == id);
    }

    public async ValueTask DisposeAsync() // this is important
    {
        await context.DisposeAsync();
    }
}
